          <form class="diagnosis-form" id="diagnosis-form">
            <div class="form-row">
              <label>Nombre
                <input id="form-name" name="name" type="text" placeholder="Tu nombre" required />
              </label>
              <label>Empresa o proyecto
                <input id="form-company" name="company" type="text" placeholder="Nombre de tu empresa" required />
              </label>
            </div>
