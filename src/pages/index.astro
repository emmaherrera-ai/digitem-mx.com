            <span class="mini-bar"></span>
            <span class="mini-circle"></span>
          </span>
          <span class="brand-word">DIGITEM-MX</span>
        </a>
        <div class="footer-tagline" aria-label="Enfoque DIGITEM-MX">
          <p>Transforma. Conecta. Evoluciona.</p>
          <p class="footer-seo-line">Software empresarial · Soluciones digitales · Infraestructura tecnológica</p>
        </div>
        <nav aria-label="Footer DIGITEM-MX">
          <a href="#metodo">Método</a>
          <a href="#soluciones">Soluciones</a>
          <a href="#contacto">Contacto</a>
        </nav>
      </div>
      <div class="copyright">© 2026 DIGITEM-MX. Todos los derechos reservados.</div>
    </footer>

    <dialog class="agenda-modal" id="agenda-modal" aria-labelledby="agenda-title">
      <form class="agenda-card" method="dialog">
        <button class="agenda-close" type="button" aria-label="Cerrar agenda" data-close-agenda>×</button>
        <p class="agenda-kicker">Agenda DIGITEM-MX</p>
        <h2 id="agenda-title">Elige fecha y horario para tu diagnóstico.</h2>
        <p class="agenda-copy">Selecciona un espacio disponible de lunes a domingo entre 9:00 a.m. y 9:00 p.m. Al enviar, abriremos WhatsApp con el mensaje listo para confirmar.</p>
        <label>Fecha de consulta
          <input id="agenda-date" name="date" type="date" required />
        </label>
        <label>Horario
          <select id="agenda-time" name="time" required>
            <option value="">Selecciona un horario</option>
            <option value="09:00">09:00 a.m.</option><option value="10:00">10:00 a.m.</option><option value="11:00">11:00 a.m.</option><option value="12:00">12:00 p.m.</option><option value="13:00">01:00 p.m.</option><option value="14:00">02:00 p.m.</option><option value="15:00">03:00 p.m.</option><option value="16:00">04:00 p.m.</option><option value="17:00">05:00 p.m.</option><option value="18:00">06:00 p.m.</option><option value="19:00">07:00 p.m.</option><option value="20:00">08:00 p.m.</option><option value="21:00">09:00 p.m.</option>
          </select>
        </label>
        <button class="btn btn-primary full" type="button" id="agenda-send">Enviar por WhatsApp</button>
        <small>Horario permitido: lunes a domingo de 9:00 a.m. a 9:00 p.m.</small>
      </form>
    </dialog>

    <script is:inline>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.matrix-nav');
      toggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
      });
      document.querySelectorAll('.matrix-nav a').forEach((link) => {
        link.addEventListener('click', () => {
          nav?.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });

      const agendaModal = document.getElementById('agenda-modal');
      const dateInput = document.getElementById('agenda-date');
      const timeInput = document.getElementById('agenda-time');
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      if (dateInput) dateInput.min = `${yyyy}-${mm}-${dd}`;
      document.querySelectorAll('[data-open-agenda]').forEach((button) => {
        button.addEventListener('click', () => agendaModal?.showModal());
      });
      document.querySelector('[data-close-agenda]')?.addEventListener('click', () => agendaModal?.close());
      document.getElementById('agenda-send')?.addEventListener('click', () => {
        const date = dateInput?.value;
        const time = timeInput?.value;
        if (!date || !time) {
          alert('Selecciona una fecha y un horario para continuar.');
          return;
        }
        const msg = encodeURIComponent(`Buena tarde, equipo de DIGITEM-MX. Me interesa agendar un diagnóstico estratégico para mi empresa el día ${date} a las ${time}.`);
        window.open(`https://wa.me/5522971545?text=${msg}`, '_blank');
        agendaModal?.close();
      });

      document.getElementById('diagnosis-form')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const name = document.getElementById('form-name')?.value?.trim();
        const company = document.getElementById('form-company')?.value?.trim();
        const contact = document.getElementById('form-contact')?.value?.trim();
        const interest = document.getElementById('form-interest')?.value;
        const context = document.getElementById('form-context')?.value?.trim();
        if (!name || !company || !contact || !interest || !context) {
          alert('Completa los campos del diagnóstico para continuar.');
          return;
        }
        const msg = encodeURIComponent(`Buena tarde, equipo de DIGITEM-MX. Me interesa solicitar un diagnóstico estratégico.

Nombre: ${name}
Empresa/proyecto: ${company}
Contacto: ${contact}
Área de interés: ${interest}
Contexto: ${context}`);
        window.open(`https://wa.me/5522971545?text=${msg}`, '_blank');
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
        });
      }, { threshold: 0.16 });
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style>
  :root {
    --orange: #E07422;
    --teal: #11999E;
    --teal-soft: #dfeff0;
    --ink: #112635;
    --muted: #66737c;
    --paper: #ffffff;
    --mist: #f5f8f8;
    --line: rgba(17, 153, 158, 0.18);
    --shadow: 0 30px 90px rgba(17, 38, 53, 0.12);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: 'Montserrat', system-ui, sans-serif;
    color: var(--ink);
    background: var(--paper);
    overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  .container { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }

  .matrix-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,.82);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(17, 38, 53, .06);
  }
  .header-inner { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 22px; }
  .brand-lockup { display: inline-flex; align-items: center; gap: 13px; font-weight: 900; letter-spacing: -.035em; }
  .brand-word {
    font-size: 1.35rem;
    background: linear-gradient(90deg, #11999E 0%, #1d9a9c 24%, #728670 50%, #b07839 75%, #E07422 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .brand-symbol { display: inline-flex; align-items: center; gap: 5px; transform: translateY(1px); }
  .mini-triangle { width: 0; height: 0; border-left: 14px solid transparent; border-right: 14px solid transparent; border-bottom: 28px solid var(--teal); }
  .mini-bar { width: 7px; height: 28px; background: rgba(17,153,158,.35); }
  .mini-circle { width: 28px; height: 28px; border-radius: 50%; background: var(--orange); }

  .matrix-nav { display: flex; align-items: center; gap: 24px; font-weight: 800; font-size: .9rem; color: rgba(17,38,53,.78); }
  .nav-item { position: relative; }
  .nav-link, .matrix-nav > a { display: inline-flex; align-items: center; min-height: 44px; transition: color .62s ease, opacity .62s ease; }
  .nav-link:hover, .nav-item:focus-within .nav-link, .matrix-nav > a:hover { color: var(--teal); }
  .apple-panel {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    width: 310px;
    padding: 18px;
    border-radius: 24px;
    background: rgba(255,255,255,.94);
    border: 1px solid rgba(17,38,53,.08);
    box-shadow: 0 28px 80px rgba(17,38,53,.14);
    backdrop-filter: blur(22px);
    transform: translate(-50%, 10px) scale(.98);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .72s ease, transform .72s cubic-bezier(.22,1,.36,1), visibility .72s ease;
  }
