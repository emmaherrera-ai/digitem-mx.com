      <section class="position-section" aria-labelledby="position-title">
        <div class="container position-shell reveal">
          <p class="eyebrow">Nuestra postura</p>
          <h2 id="position-title">No vendemos solo servicios.</h2>
          <p>Construimos activos digitales, soluciones verticales y entornos tecnológicos listos para crecer contigo.</p>
        </div>
      </section>

      <section id="contacto" class="final-cta" aria-labelledby="cta-title">
