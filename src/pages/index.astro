---
const whatsappBase = 'https://wa.me/5522971545';
const consultMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX. Me interesa solicitar una consulta digital para revisar oportunidades de crecimiento para mi empresa.');
const infoMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX. Me gustaría recibir más información sobre sus servicios digitales.');
const diagnosisMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX. Me interesa solicitar un diagnóstico digital para mi empresa.');
const consultUrl = `${whatsappBase}?text=${consultMessage}`;
const infoUrl = `${whatsappBase}?text=${infoMessage}`;
const diagnosisUrl = `${whatsappBase}?text=${diagnosisMessage}`;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DIGITEM-MX | Transformación Digital para Empresas</title>
    <meta name="description" content="Soluciones digitales a medida para impulsar el crecimiento de tu empresa. Desarrollo web, consultoría digital, COREM-Suite y servicios digitales en México." />
    <meta property="og:title" content="DIGITEM-MX | Transformación Digital para Empresas" />
    <meta property="og:description" content="Transforma, conecta y evoluciona con soluciones digitales accesibles, confiables y de alta calidad." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://digitem-mx.com" />
    <link rel="canonical" href="https://digitem-mx.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Lato:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="matrix-header" aria-label="Navegación principal DIGITEM-MX">
      <div class="container header-inner">
        <a class="matrix-logo" href="/" aria-label="Ir al inicio de DIGITEM-MX">
          <span>DIGITEM-MX</span>
        </a>
        <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false">☰</button>
        <nav class="matrix-nav" aria-label="Secciones de la matriz">
          <a href="#inicio">Inicio</a>
          <a href="#nosotros">Nosotros</a>
          <a href="#servicios">Servicios</a>
          <a href="http://www.corem-mx.org" target="_blank" rel="noopener noreferrer">COREM-Suite</a>
          <a href="#socios">Socios Comerciales</a>
          <a href="#contacto">Contacto</a>
          <a class="nav-button" href={consultUrl}>Agenda</a>
          <a class="login-button" href="https://suite.digitem-mx.com" target="_blank" rel="noopener noreferrer">Iniciar</a>
        </nav>
      </div>
    </header>

    <main>
      <section id="inicio" class="matrix-hero" aria-labelledby="matrix-hero-title">
        <div class="container hero-grid">
          <div class="hero-copy fade-in">
            <h1 id="matrix-hero-title">Transforma.<br />Conecta.<br />Evoluciona.</h1>
            <p>Soluciones digitales a medida para impulsar el crecimiento de tu empresa en la era digital.</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={consultUrl}>Solicitar Consulta Digital</a>
              <a class="btn btn-secondary" href="#servicios">Conoce Nuestros Servicios <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <div class="hero-art slide-up" aria-hidden="true">
            <div class="art-bg"></div>
            <div class="brand-shapes">
              <div class="shape-triangle"></div>
              <div class="shape-bar"></div>
              <div class="shape-circle"></div>
            </div>
          </div>
        </div>
      </section>

      <section id="nosotros" class="section section-alt" aria-labelledby="about-title">
        <div class="container">
          <h2 id="about-title" class="section-title">Nosotros</h2>
          <div class="two-grid">
            <article class="soft-card">
              <div class="icon-badge">◎</div>
              <h3>Misión</h3>
              <p>Ayudar a empresas a evolucionar con tecnología accesible, proporcionando soluciones digitales que impulsen su crecimiento y optimicen sus procesos de negocio.</p>
            </article>
            <article class="soft-card">
              <div class="icon-badge">◌</div>
              <h3>Visión</h3>
              <p>Ser la consultora líder en transformación digital para negocios en Latinoamérica, reconocida por su excelencia, innovación y compromiso con el éxito de sus clientes.</p>
            </article>
          </div>
          <h3 class="section-subtitle">Nuestros Valores</h3>
          <div class="values-grid">
            <article class="value-card"><div>△</div><h4>Innovación</h4><p>Buscamos nuevas formas de resolver problemas y mejorar procesos.</p></article>
            <article class="value-card"><div>◇</div><h4>Integridad</h4><p>Actuamos con honestidad, transparencia y ética en cada proyecto.</p></article>
            <article class="value-card"><div>□</div><h4>Calidad</h4><p>Nos comprometemos a entregar soluciones de alta calidad y excelencia.</p></article>
            <article class="value-card"><div>○</div><h4>Impacto</h4><p>Generamos resultados medibles y significativos para nuestros clientes.</p></article>
          </div>
        </div>
      </section>

      <section id="servicios" class="section" aria-labelledby="services-title">
        <div class="container">
          <h2 id="services-title" class="section-title">Nuestros Servicios</h2>
          <p class="section-lead">Ofrecemos soluciones integrales para impulsar la transformación digital de tu empresa, desde software especializado hasta consultoría estratégica.</p>
          <div class="services-grid">
            <article class="service-card">
              <div class="service-icon">▣</div>
              <h3>COREM-Suite</h3>
              <p>Solución modular de gestión empresarial que integra ERP y CRM para optimizar tus procesos de negocio.</p>
              <ul><li>Gestor de inventario</li><li>Cotizador y POS</li><li>CRM y seguimiento de clientes</li><li>Dashboards y reportes</li></ul>
              <a class="btn btn-primary full" href="http://www.corem-mx.org" target="_blank" rel="noopener noreferrer">Ver Más</a>
            </article>
            <article class="service-card featured-service">
              <div class="service-icon">✦</div>
              <h3>DIGITEM-MX Salud</h3>
              <p>Landing pages SEO para profesionales de salud que quieren ser encontrados, transmitir confianza y recibir citas por WhatsApp.</p>
              <ul><li>Landing SEO Pacientes</li><li>Paquetes Salud Pro y Max</li><li>SEO local y WhatsApp</li><li>Demos por especialidad</li></ul>
              <a class="btn btn-primary full" href="/salud">Ver DIGITEM-MX Salud</a>
            </article>
            <article class="service-card">
              <div class="service-icon">◈</div>
              <h3>Servicios Digitales</h3>
              <p>Soluciones creativas para fortalecer tu presencia digital y comunicar efectivamente tu marca.</p>
              <ul><li>Branding e identidad</li><li>Diseño web y landing pages</li><li>Papelería creativa</li><li>Material promocional</li></ul>
              <a class="btn btn-primary full" href={infoUrl}>Solicitar Información</a>
            </article>
            <article class="service-card">
              <div class="service-icon">⌁</div>
              <h3>Consultoría Digital</h3>
              <p>Asesoría estratégica para optimizar tus procesos y aprovechar mejor las tecnologías digitales.</p>
              <ul><li>Diagnóstico digital</li><li>Sesiones estratégicas</li><li>Automatización de procesos</li><li>Implementación de herramientas</li></ul>
              <a class="btn btn-primary full" href={diagnosisUrl}>Solicitar Diagnóstico</a>
            </article>
          </div>
        </div>
      </section>

      <section id="socios" class="section section-alt" aria-labelledby="partners-title">
        <div class="container">
          <h2 id="partners-title" class="section-title">Socios Comerciales</h2>
          <p class="section-lead">Colaboramos con empresas líderes para ofrecer soluciones integrales y de calidad.</p>
          <div class="partners-grid">
            <a href="https://integrity-mexico.com" target="_blank" rel="noopener noreferrer"><span>I</span><strong>Integrity México</strong></a>
            <a href="https://grupogabssa.com" target="_blank" rel="noopener noreferrer"><span>G</span><strong>Grupo Gabssa</strong></a>
            <a href="https://ndm4.com" target="_blank" rel="noopener noreferrer"><span>N</span><strong>NDM4</strong></a>
            <a href="https://inner-lux.com.mx" target="_blank" rel="noopener noreferrer"><span>I</span><strong>Inner-Lux</strong></a>
            <a href="https://katorce-espacios.com" target="_blank" rel="noopener noreferrer"><span>K</span><strong>Katorce Espacios</strong></a>
          </div>
        </div>
      </section>

      <section id="contacto" class="section" aria-labelledby="contact-title">
        <div class="container">
          <h2 id="contact-title" class="section-title">Contacto</h2>
          <p class="section-lead">Estamos listos para ayudarte a transformar digitalmente tu negocio. Contáctanos y comencemos a trabajar juntos.</p>
          <div class="contact-grid">
            <form class="contact-form" id="contact-form">
              <h3>Envíanos un mensaje</h3>
              <label>Nombre completo<input name="name" type="text" required /></label>
              <label>Correo electrónico<input name="email" type="email" required /></label>
              <label>Número de teléfono<input name="phone" type="tel" required /></label>
              <label>Servicio de interés
                <select name="service" required>
                  <option value="">Selecciona un servicio</option>
                  <option value="DIGITEM-MX Salud">DIGITEM-MX Salud</option>
                  <option value="COREM-Suite">COREM-Suite</option>
                  <option value="Servicios Digitales">Servicios Digitales</option>
                  <option value="Consultoría Digital">Consultoría Digital</option>
                </select>
              </label>
              <label>Mensaje<textarea name="message" rows="4" required></textarea></label>
              <button class="btn btn-primary full" type="submit">Solicitar Consulta Digital</button>
            </form>
            <aside class="contact-info">
              <h3>Información de contacto</h3>
              <div class="info-item"><span>☎</span><div><h4>Teléfono</h4><p>+52 55 2297 1545</p><small>Lunes a viernes, 9:00 - 18:00</small></div></div>
              <div class="info-item"><span>✉</span><div><h4>Correo electrónico</h4><p>emma_herrera@digitem-mx.com</p><small>Respondemos en menos de 24 horas</small></div></div>
              <div class="info-item"><span>⌖</span><div><h4>Ubicación</h4><p>Ciudad de México, México</p><small>También trabajamos de forma remota</small></div></div>
              <div class="social-row">
                <a href="https://www.instagram.com/digitem.mx/" target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href={consultUrl}>WhatsApp</a>
                <a href="mailto:emma_herrera@digitem-mx.com">Correo</a>
              </div>
            </aside>
          </div>
        </div>
      </section>
    </main>

    <footer class="matrix-footer">
      <div class="container footer-grid">
        <div><a class="matrix-logo" href="/"><span>DIGITEM-MX</span></a><p>Soluciones digitales para impulsar el crecimiento de tu empresa en la era digital.</p></div>
        <div><h4>Enlaces rápidos</h4><a href="#inicio">Inicio</a><a href="#nosotros">Nosotros</a><a href="#servicios">Servicios</a><a href="#contacto">Contacto</a></div>
        <div><h4>Servicios</h4><a href="/salud">DIGITEM-MX Salud</a><a href="http://www.corem-mx.org" target="_blank" rel="noopener noreferrer">COREM-Suite</a><a href="#servicios">Servicios Digitales</a><a href="#servicios">Consultoría Digital</a></div>
        <div><h4>Legal</h4><a href="#contacto">Aviso de Privacidad</a><a href="#contacto">Términos y Condiciones</a></div>
      </div>
      <div class="copyright">© 2026 DIGITEM-MX. Todos los derechos reservados.</div>
    </footer>

    <script is:inline>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.matrix-nav');
      toggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
      });
      document.querySelectorAll('.matrix-nav a').forEach((link) => {
        link.addEventListener('click', () => {
          nav?.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });
      const form = document.querySelector('#contact-form');
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const message = `Consulta Digital DIGITEM-MX\n\nNombre: ${data.get('name')}\nEmail: ${data.get('email')}\nTeléfono: ${data.get('phone')}\nServicio: ${data.get('service')}\nMensaje: ${data.get('message')}`;
        window.open(`https://wa.me/5522971545?text=${encodeURIComponent(message)}`, '_blank');
      });
    </script>

    <style>
      :root{--orange:#E07422;--blue:#11999E;--gray-light:#F0F0F0;--gray-dark:#333333;--white:#fff;--ink:#0f1e28;--shadow:0 20px 60px rgba(15,30,40,.10)}
      *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Lato,Montserrat,system-ui,sans-serif;color:var(--gray-dark);background:#fff}a{color:inherit;text-decoration:none}h1,h2,h3,h4{font-family:Montserrat,system-ui,sans-serif;color:var(--blue);margin:0}p{line-height:1.7}.container{width:min(1180px,calc(100% - 32px));margin-inline:auto}.matrix-header{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(255,255,255,.84);backdrop-filter:blur(18px);border-bottom:1px solid rgba(17,153,158,.10);box-shadow:0 10px 30px rgba(15,30,40,.05)}.header-inner{height:76px;display:flex;align-items:center;justify-content:space-between}.matrix-logo{font-family:Montserrat,sans-serif;font-weight:900;font-size:clamp(1.1rem,2vw,1.45rem);letter-spacing:.02em;background:linear-gradient(90deg,var(--blue),var(--orange));-webkit-background-clip:text;background-clip:text;color:transparent}.matrix-nav{display:flex;align-items:center;gap:22px;font-family:Montserrat,sans-serif;font-weight:700;font-size:.9rem}.matrix-nav a:not(.nav-button):not(.login-button){color:#344;transition:.25s}.matrix-nav a:hover{color:var(--blue)}.nav-button,.login-button{padding:.65rem 1rem;border-radius:10px;font-weight:800;font-size:.84rem}.nav-button{background:var(--orange);color:white}.login-button{border:1px solid rgba(17,153,158,.25);color:var(--blue);background:white}.menu-toggle{display:none;background:white;border:1px solid #d9e5e6;border-radius:12px;padding:.55rem .75rem;font-size:1.2rem}.matrix-hero{padding:150px 0 92px;background:linear-gradient(135deg,#fff 0%,#f0f7f7 45%,#fff 100%);overflow:hidden}.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.hero-copy h1{font-size:clamp(3.4rem,7vw,5.8rem);line-height:.95;letter-spacing:-.055em;margin-bottom:28px}.hero-copy p{font-size:1.22rem;max-width:560px;margin-bottom:32px}.hero-actions{display:flex;gap:16px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:.95rem 1.35rem;font-family:Montserrat,sans-serif;font-weight:800;transition:.25s ease;border:1px solid transparent}.btn:hover{transform:translateY(-2px);box-shadow:0 14px 28px rgba(15,30,40,.10)}.btn-primary{background:var(--orange);color:white}.btn-secondary{background:rgba(255,255,255,.85);color:var(--blue);border-color:rgba(17,153,158,.2);backdrop-filter:blur(12px)}.hero-art{position:relative;min-height:420px;display:grid;place-items:center}.art-bg{position:absolute;width:min(440px,90%);aspect-ratio:1;background:rgba(17,153,158,.10);border-radius:999px;animation:pulse 4s ease-in-out infinite}.brand-shapes{position:relative;display:flex;align-items:center;gap:16px}.shape-triangle{width:120px;height:120px;background:var(--blue);clip-path:polygon(0 100%,50% 0,100% 100%);transform:rotate(90deg)}.shape-bar{width:22px;height:120px;background:rgba(17,153,158,.28)}.shape-circle{width:120px;height:120px;border-radius:50%;background:rgba(224,116,34,.86)}.section{padding:92px 0}.section-alt{background:var(--gray-light)}.section-title{text-align:center;font-size:clamp(2rem,4vw,3rem);margin-bottom:18px}.section-subtitle{text-align:center;font-size:1.6rem;margin:48px 0 24px}.section-lead{text-align:center;font-size:1.12rem;max-width:760px;margin:0 auto 54px}.two-grid,.contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:32px}.soft-card,.service-card,.contact-form,.contact-info{background:white;border:1px solid rgba(17,153,158,.12);border-radius:22px;padding:32px;box-shadow:var(--shadow)}.soft-card h3,.service-card h3,.contact-form h3,.contact-info h3{font-size:1.6rem;margin-bottom:14px}.icon-badge,.service-icon{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:rgba(17,153,158,.10);color:var(--blue);font-size:2rem;margin-bottom:18px}.values-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.value-card{background:white;border-radius:18px;padding:24px;text-align:center;box-shadow:0 10px 30px rgba(15,30,40,.06)}.value-card div{width:56px;height:56px;margin:0 auto 14px;border-radius:50%;background:rgba(17,153,158,.10);color:var(--blue);display:grid;place-items:center;font-size:1.8rem}.services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.service-card{display:flex;flex-direction:column}.featured-service{border-color:rgba(224,116,34,.35);background:linear-gradient(180deg,#fff,#fff9f4)}.service-card ul{padding:0;margin:8px 0 24px;list-style:none}.service-card li{margin:.55rem 0;padding-left:1.1rem;position:relative}.service-card li:before{content:'•';position:absolute;left:0;color:var(--orange);font-weight:900}.full{width:100%;margin-top:auto}.partners-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}.partners-grid a{background:white;border-radius:18px;padding:22px;text-align:center;box-shadow:0 10px 30px rgba(15,30,40,.06);transition:.25s}.partners-grid a:hover{transform:translateY(-4px);box-shadow:var(--shadow)}.partners-grid span{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;background:rgba(17,153,158,.10);color:var(--blue);font-family:Montserrat,sans-serif;font-weight:900;font-size:1.5rem;margin:0 auto 12px}.contact-form label{display:block;font-weight:700;margin-bottom:14px}.contact-form input,.contact-form select,.contact-form textarea{width:100%;margin-top:8px;border:1px solid #dde7e8;border-radius:14px;padding:.85rem 1rem;font:inherit}.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{outline:2px solid rgba(17,153,158,.25);border-color:var(--blue)}.contact-info{background:#f5f7f7}.info-item{display:flex;gap:16px;margin:26px 0}.info-item>span{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:rgba(17,153,158,.10);color:var(--blue);flex:0 0 auto}.info-item h4{margin:.1rem 0 .25rem;color:var(--ink)}.info-item p{margin:0}.info-item small{opacity:.7}.social-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px}.social-row a{padding:.65rem 1rem;border-radius:999px;background:var(--blue);color:white;font-family:Montserrat,sans-serif;font-weight:800;font-size:.85rem}.matrix-footer{background:var(--gray-light);padding:56px 0 24px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:28px}.footer-grid h4{margin-bottom:14px}.footer-grid a{display:block;margin:.55rem 0;color:#4a5558}.footer-grid a:hover{color:var(--blue)}.copyright{text-align:center;border-top:1px solid #d5dede;margin-top:38px;padding-top:22px;color:#687275;font-size:.9rem}.fade-in{animation:fadeIn .65s ease}.slide-up{animation:slideUp .7s ease}@keyframes fadeIn{from{opacity:0}to{opacity:1}}@keyframes slideUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.03)}}
      @media (max-width:980px){.matrix-nav{display:none;position:absolute;top:76px;left:16px;right:16px;flex-direction:column;align-items:stretch;background:rgba(255,255,255,.95);backdrop-filter:blur(18px);border:1px solid rgba(17,153,158,.12);border-radius:20px;padding:18px;box-shadow:var(--shadow)}.matrix-nav.is-open{display:flex}.menu-toggle{display:block}.hero-grid,.two-grid,.contact-grid{grid-template-columns:1fr}.matrix-hero{padding:124px 0 70px}.hero-copy h1{font-size:clamp(2.9rem,15vw,4.8rem)}.hero-art{min-height:300px}.values-grid,.services-grid{grid-template-columns:repeat(2,1fr)}.partners-grid{grid-template-columns:repeat(2,1fr)}.footer-grid{grid-template-columns:1fr 1fr}.shape-triangle,.shape-circle{width:88px;height:88px}.shape-bar{height:88px}.section{padding:70px 0}}
      @media (max-width:620px){.container{width:min(100% - 24px,1180px)}.header-inner{height:68px}.matrix-hero{padding:112px 0 58px}.hero-copy h1{font-size:3.15rem}.hero-copy p{font-size:1.05rem}.hero-actions .btn{width:100%}.values-grid,.services-grid,.partners-grid,.footer-grid{grid-template-columns:1fr}.soft-card,.service-card,.contact-form,.contact-info{padding:24px}.hero-art{min-height:220px}.art-bg{width:260px}.section-title{text-align:left}.section-lead{text-align:left;margin-left:0}.shape-triangle,.shape-circle{width:72px;height:72px}.shape-bar{height:72px;width:14px}}
    </style>
  </body>
</html>
