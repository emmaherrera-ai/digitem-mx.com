              <label>Contacto
                <input id="form-contact" name="contact" type="text" placeholder="WhatsApp o correo" required />
              </label>
              <label>Área de interés
                <select id="form-interest" name="interest" required>
                  <option value="">Selecciona una opción</option>
                  <option value="COREM">COREM · Orden operativo</option>
                  <option value="DIGITEM Salud">DIGITEM Salud · Captación y presencia</option>
                  <option value="DIGITEM IT">DIGITEM IT · Infraestructura y soporte</option>
                  <option value="Diagnóstico integral DIGITEM-MX">Diagnóstico integral DIGITEM-MX</option>
                </select>
              </label>
            </div>
            <label>Contexto breve
              <textarea id="form-context" name="context" rows="4" placeholder="Ej. Quiero ordenar mis procesos, mejorar mi presencia digital o revisar mi infraestructura tecnológica." required></textarea>
            </label>
            <button class="btn btn-primary full" type="submit">Enviar diagnóstico por WhatsApp</button>
          </form>
