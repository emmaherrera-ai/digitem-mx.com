const whatsapp = 'https://wa.me/5522971545';
const auditMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX Salud. Me interesa solicitar mi auditoría de 5 minutos para revisar la presencia digital de mi consultorio.');
const questionMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX Salud. Tengo una pregunta sobre sus landing pages SEO para profesionales de salud.');
const auditUrl = `${whatsapp}?text=${auditMessage}`;
const questionUrl = `${whatsapp}?text=${questionMessage}`;

const faqs = [
  {
    q: '¿Por qué un médico o dentista necesita una landing page propia si ya tiene Instagram o Facebook?',
    a: 'Las redes sociales son excelentes para crear comunidad, pero una landing page SEO es tu consultorio digital propio. Mientras en las redes tu contenido se pierde en horas, una página web optimizada posiciona tus servicios de forma permanente en Google para que los pacientes de tu zona te encuentren exactamente cuando necesitan tu especialidad médica.'
  },
  {
    q: '¿Qué diferencia hay entre una Landing SEO de DIGITEM-MX y perfiles como Doctoralia?',
    a: 'Los directorios médicos te obligan a competir codo a codo, y por precio, con cientos de colegas en la misma pantalla. Una landing page exclusiva es un activo digital diseñado para destacar tu propuesta de valor, generar confianza sin distracciones y dirigir al paciente a tu WhatsApp de forma directa y sin intermediarios.'
  },
  {
    q: 'No tengo tiempo para administrar un sitio web, ¿cómo me ayuda su servicio?',
    a: 'No tienes que hacer nada. En DIGITEM-MX Salud entregamos tu landing page lista para funcionar, optimizada y publicada en internet. No requiere mantenimiento diario ni conocimientos técnicos de tu parte; está hecha para trabajar en automático atrayendo pacientes mientras tú atiendes en consulta.'
  },
  {
    q: '¿Cómo ayudan a que mi consultorio esté mejor preparado para aparecer en búsquedas locales de Google?',
    a: 'Google valora la estructura técnica, la velocidad de carga y la relevancia local. Con nuestro paquete Salud Max implementamos SEO local avanzado, optimización de palabras clave por servicio y marcado de datos estructurados Schema JSON-LD. Construimos una base técnica sólida para que tu consultorio esté mejor preparado para competir en las búsquedas de tu zona geográfica.'
  }
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};
