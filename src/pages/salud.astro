      /* V4 refinements */
      .hero{min-height:auto;min-height:calc(100vh - 18px);padding-top:104px;padding-bottom:42px;position:relative;isolation:isolate;}
      .hero:before{content:"";position:absolute;inset:72px 2vw 18px;border-radius:44px;background:radial-gradient(circle at 16% 18%,rgba(17,153,158,.08),transparent 28%),radial-gradient(circle at 68% 24%,rgba(224,116,34,.08),transparent 24%),linear-gradient(135deg,rgba(240,240,240,.82),rgba(255,255,255,.62));z-index:-1;}
      .hero h1{font-size:clamp(2.55rem,4.9vw,5.85rem);line-height:1.02;letter-spacing:-.058em;max-width:820px;text-wrap:balance;}
      .highlight-teal{color:var(--teal)!important;white-space:normal;}
      .highlight-orange{color:var(--orange)!important;white-space:normal;}
      .hero-text{font-size:clamp(1rem,1.12vw,1.16rem);line-height:1.68;max-width:760px;}
      .medical-bg{background:radial-gradient(circle at 52% 44%,rgba(17,153,158,.16),transparent 42%),radial-gradient(circle at 78% 22%,rgba(224,116,34,.14),transparent 24%),linear-gradient(135deg,rgba(255,255,255,.18),rgba(17,153,158,.08));box-shadow:inset 0 0 0 1px rgba(17,153,158,.10);}
      .medical-bg:before{opacity:.9;}
      .float-card{transition:transform .42s var(--ease),box-shadow .42s var(--ease),background .42s var(--ease),border-color .42s var(--ease);}
      .float-card:hover{transform:translateY(-6px) scale(1.015);background:rgba(255,255,255,.78);border-color:rgba(17,153,158,.32);box-shadow:0 26px 62px rgba(16,32,44,.17);}
      .benefit-card{background:white;}
      .benefit-card:hover{background:linear-gradient(180deg,rgba(17,153,158,.08),rgba(255,255,255,.86));border-color:rgba(17,153,158,.30);box-shadow:0 22px 48px rgba(17,153,158,.12);}
      .benefit-card:hover .icon-line{transform:translateY(-2px);color:var(--teal-dark);}
      .icon-line{transition:transform .35s var(--ease),color .35s var(--ease);}
      .pricing-grid-v4{grid-template-columns:1fr 1fr;align-items:stretch;}
      .pricing-grid-v4 .price-card{display:flex;flex-direction:column;min-height:100%;}
      .pricing-grid-v4 .price-card ul{margin-bottom:12px;}
      .pricing-grid-v4 .price-card .full{margin-top:auto;}
      .why-card-v4{grid-column:1/-1;display:grid;grid-template-columns:.72fr 1.28fr;gap:28px;align-items:center;background:linear-gradient(135deg,rgba(255,255,255,.94),rgba(240,248,248,.86));}
      .why-card-v4 h3{font-size:clamp(1.6rem,2.4vw,2.55rem);line-height:1.06;letter-spacing:-.045em;margin:0 0 12px;}
      .why-intro p:not(.kicker){color:var(--muted);line-height:1.65;margin:0;}
      .why-list{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
      .why-list .why-item{display:block;margin:0;padding:18px;border:1px solid rgba(17,153,158,.13);border-radius:20px;background:rgba(255,255,255,.68);}
      .why-list .why-item span{margin-bottom:14px;background:rgba(17,153,158,.12);color:var(--teal-dark);}
      .final-actions{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;}
      .final-actions .btn{width:100%;min-height:62px;text-align:center;padding-inline:22px;}
      .demo-card img,.specialty-card img{filter:saturate(.96) contrast(1.02);}
      @media (max-width:1100px){.pricing-grid-v4,.why-card-v4{grid-template-columns:1fr}.why-list{grid-template-columns:repeat(2,1fr)}.hero{min-height:auto}.hero:before{inset:78px 12px 16px}}
      @media (max-width:720px){.hero h1{font-size:2.85rem;line-height:1.06;letter-spacing:-.045em}.hero:before{border-radius:28px}.why-list{grid-template-columns:1fr}.final-actions{grid-template-columns:1fr}.float-card:hover{transform:scale(.85) translateY(-4px)}}


