    <script>
      const modalContent = {
        digitem: ['DIGITEM-MX', 'DIGITEM-MX es una consultora de servicios digitales enfocada en ayudar a negocios, emprendedores y PYMES a evolucionar mediante soluciones claras, accesibles y profesionales.'],
        salud: ['DIGITEM-MX Salud', 'DIGITEM-MX Salud es la vertical especializada en landing pages SEO para profesionales de salud que buscan mejorar su presencia digital y facilitar el contacto por WhatsApp.'],
        corem: ['COREM', 'COREM es la línea de gestión y consultoría empresarial de DIGITEM-MX, pensada para ordenar procesos, datos y operación digital.'],
        privacy: ['Aviso de Privacidad', 'Los datos compartidos por correo o WhatsApp se utilizan únicamente para responder solicitudes, preparar diagnósticos y dar seguimiento a servicios de DIGITEM-MX. No vendemos ni compartimos información personal con terceros.'],
        terms: ['Términos y Condiciones', 'Los servicios, tiempos de entrega y alcances se confirman por escrito antes de iniciar cada proyecto. Las landings incluyen las rondas de ajuste indicadas en el paquete contratado.']
      };
      const dialog = document.querySelector('#infoModal');
      const title = document.querySelector('#modalTitle');
      const text = document.querySelector('#modalText');
      document.querySelectorAll('[data-modal]').forEach((button) => {
        button.addEventListener('click', () => {
          const data = modalContent[button.dataset.modal];
          title.textContent = data[0];
          text.textContent = data[1];
          dialog.showModal();
        });
      });
      document.querySelector('.modal-close')?.addEventListener('click', () => dialog.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    </script>
