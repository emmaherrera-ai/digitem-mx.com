---
const title = 'DIGITEM Suite | Restablecer contraseña';
const description = 'Restablecimiento seguro de contraseña para usuarios internos de DIGITEM Suite.';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="reset-shell">
      <section class="reset-card">
        <a class="brand" href="/suite/login">DIGITEM-MX</a>
        <p class="eyebrow">Seguridad de cuenta</p>
        <h1>Restablecer contraseña</h1>
        <p class="lead" id="leadText">Solicita un enlace seguro para actualizar tu contraseña de DIGITEM Suite.</p>

        <form id="requestForm" class="auth-form">
          <label>
            <span>Correo autorizado</span>
            <input id="email" type="email" placeholder="correo@digitem-mx.com" autocomplete="email" required />
          </label>
          <button type="submit">Enviar enlace de restablecimiento</button>
        </form>

        <form id="updateForm" class="auth-form hidden">
          <label>
            <span>Nueva contraseña</span>
            <input id="newPassword" type="password" placeholder="Mínimo 8 caracteres" autocomplete="new-password" minlength="8" required />
          </label>
          <label>
            <span>Confirmar contraseña</span>
            <input id="confirmPassword" type="password" placeholder="Repite tu nueva contraseña" autocomplete="new-password" minlength="8" required />
          </label>
          <button type="submit">Guardar nueva contraseña</button>
        </form>

        <p id="authMessage" class="auth-message" role="status"></p>

        <div class="note">
          <strong>Importante:</strong> el enlace de restablecimiento solo funciona para correos registrados manualmente en Supabase Auth.
        </div>

        <div class="links">
          <a href="/suite/login">Volver al login</a>
          <a href="/suite/">Ir al dashboard</a>
        </div>
      </section>
    </main>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

      const SUPABASE_URL = 'https://cppplmloraanbnseqnka.supabase.co';
      const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNwcHBsbWxvcmFhbmJuc2VxbmthIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE3Mjk5MjYsImV4cCI6MjA5NzMwNTkyNn0.Nw80dCvEqd2jmYo5pR1oVSfpDV2EQxV46W0YKuoOPbE';
      const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const requestForm = document.getElementById('requestForm');
      const updateForm = document.getElementById('updateForm');
      const emailInput = document.getElementById('email');
      const newPasswordInput = document.getElementById('newPassword');
      const confirmPasswordInput = document.getElementById('confirmPassword');
      const message = document.getElementById('authMessage');
      const leadText = document.getElementById('leadText');

      function setMessage(text, type = '') {
        message.textContent = text;
        message.className = `auth-message ${type}`.trim();
      }

      function showUpdateMode() {
        requestForm.classList.add('hidden');
        updateForm.classList.remove('hidden');
        leadText.textContent = 'Ingresa tu nueva contraseña para completar el restablecimiento.';
      }

      supabase.auth.onAuthStateChange((event) => {
        if (event === 'PASSWORD_RECOVERY') showUpdateMode();
      });

      const { data } = await supabase.auth.getSession();
      if (data?.session && window.location.hash.includes('type=recovery')) {
        showUpdateMode();
      }

      requestForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setMessage('');
        const button = requestForm.querySelector('button');
        button.disabled = true;
        button.textContent = 'Enviando enlace…';

        const redirectTo = `${window.location.origin}/suite/reset`;
        const { error } = await supabase.auth.resetPasswordForEmail(emailInput.value.trim(), { redirectTo });

        button.disabled = false;
        button.textContent = 'Enviar enlace de restablecimiento';

        if (error) {
          setMessage('No pudimos enviar el enlace. Revisa que el correo esté autorizado o intenta más tarde.', 'error');
          return;
        }

        setMessage('Listo. Si el correo está autorizado, recibirás un enlace para actualizar tu contraseña.', 'success');
      });

      updateForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        setMessage('');
        const password = newPasswordInput.value;
        const confirm = confirmPasswordInput.value;

        if (password !== confirm) {
          setMessage('Las contraseñas no coinciden.', 'error');
          return;
        }

        const button = updateForm.querySelector('button');
        button.disabled = true;
        button.textContent = 'Guardando…';

        const { error } = await supabase.auth.updateUser({ password });

        button.disabled = false;
        button.textContent = 'Guardar nueva contraseña';

        if (error) {
          setMessage('No pudimos actualizar tu contraseña. Solicita un nuevo enlace de restablecimiento.', 'error');
          return;
        }

        setMessage('Contraseña actualizada correctamente. Redirigiendo al dashboard…', 'success');
        setTimeout(() => { window.location.href = '/suite/'; }, 1000);
      });
    </script>
  </body>
</html>

<style>
  :root { --orange:#E07422; --teal:#11999E; --ink:#0f2430; --muted:#66737d; --line:rgba(17,24,39,.11); }
  * { box-sizing: border-box; }
  body { margin:0; min-height:100svh; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color:var(--ink); background: radial-gradient(circle at 14% 10%, rgba(17,153,158,.16), transparent 32%), radial-gradient(circle at 86% 18%, rgba(224,116,34,.12), transparent 28%), linear-gradient(135deg,#fff,#f6fbfb); }
  a { color: inherit; text-decoration: none; }
  .reset-shell { min-height:100svh; display:grid; place-items:center; padding:22px; }
  .reset-card { width:min(100%, 560px); border:1px solid rgba(255,255,255,.72); border-radius:34px; padding:clamp(28px,5vw,48px); background:rgba(255,255,255,.82); box-shadow:0 28px 88px rgba(17,24,39,.12); backdrop-filter:blur(24px); }
  .brand { display:block; width:max-content; margin-bottom:38px; font-size:1.45rem; font-weight:900; letter-spacing:-.07em; background:linear-gradient(100deg,var(--teal),#176b78 46%,var(--orange)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .eyebrow { margin:0 0 12px; color:var(--teal); text-transform:uppercase; letter-spacing:.16em; font-size:.72rem; font-weight:900; }
  h1,p { margin-top:0; }
  h1 { margin-bottom:14px; font-size:clamp(2.3rem,5vw,4rem); line-height:.96; letter-spacing:-.07em; }
  .lead { color:var(--muted); line-height:1.7; margin-bottom:28px; }
  .auth-form { display:grid; gap:18px; }
  .auth-form.hidden { display:none; }
  label { display:grid; gap:8px; font-weight:800; font-size:.92rem; }
  input { width:100%; border:1px solid var(--line); border-radius:16px; padding:15px 16px; font:inherit; background:#fff; transition:border-color .32s ease, box-shadow .32s ease; }
  input:focus { outline:none; border-color:rgba(17,153,158,.56); box-shadow:0 0 0 5px rgba(17,153,158,.10); }
  button { border:0; border-radius:999px; padding:16px 22px; font:inherit; font-weight:900; color:#fff; cursor:pointer; background:linear-gradient(135deg,var(--teal),#176b78 55%,var(--orange)); box-shadow:0 18px 42px rgba(17,153,158,.22); transition:transform .38s ease, box-shadow .38s ease; }
  button:hover { transform:translateY(-2px); box-shadow:0 22px 50px rgba(17,153,158,.28); }
  button:disabled { cursor:wait; opacity:.72; transform:none; }
  .auth-message { margin:18px 0 0; min-height:24px; color:var(--muted); font-weight:800; line-height:1.55; }
  .auth-message.error { color:#b42318; }
  .auth-message.success { color:#126f78; }
  .note { margin-top:24px; border:1px solid rgba(17,153,158,.16); border-radius:18px; background:rgba(17,153,158,.07); padding:16px; color:#2d5357; font-size:.9rem; line-height:1.65; }
  .links { margin-top:20px; display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; font-size:.9rem; font-weight:800; }
  .links a { color:#126f78; }
</style>
