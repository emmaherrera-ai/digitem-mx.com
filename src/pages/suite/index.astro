---
const title = 'DIGITEM Suite | Pipeline comercial interno';
const description = 'Dashboard interno de DIGITEM-MX para prospección, Perspectiva Digital Express, recomendaciones, objeciones y seguimiento.';
const scoreBlocks = [
  ['visibilityScore', 'Visibilidad local', '¿El paciente puede encontrar al especialista en Google buscando su servicio + zona?'],
  ['trustScore', 'Confianza', '¿La presencia digital proyecta profesionalismo y cercanía antes del primer contacto?'],
  ['clarityScore', 'Claridad del servicio', '¿El paciente entiende qué atiende, cómo ayuda y cuándo debe escribir?'],
  ['conversionScore', 'Contacto por WhatsApp', '¿Es fácil escribirle sin buscar demasiado?'],
  ['presenceScore', 'Presencia profesional', '¿Su presencia digital se siente actual, confiable y competitiva?'],
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="suite-shell" data-suite-app>
      <aside class="sidebar">
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Volver a DIGITEM-MX">DIGITEM-MX</a>
          <p>Suite interna</p>
        </div>

        <nav aria-label="Pipeline comercial DIGITEM Salud">
          <button class="nav-item active" type="button" data-panel="overview"><span>00</span>Dashboard</button>
          <button class="nav-item" type="button" data-panel="prospecting"><span>01</span>Prospección</button>
          <button class="nav-item" type="button" data-panel="evaluation"><span>02</span>Evaluación</button>
          <button class="nav-item" type="button" data-panel="recommendation"><span>03</span>Recomendación</button>
          <button class="nav-item" type="button" data-panel="objections"><span>04</span>Objeciones</button>
          <button class="nav-item" type="button" data-panel="followup"><span>05</span>Seguimiento</button>
          <a class="nav-item link-item" href="/suite/reset"><span>⚙</span>Seguridad</a>
        </nav>

        <div class="sidebar-footer">
          <small>Flujo comercial</small>
          <strong>Prospectar → Evaluar → Recomendar → Responder → Dar seguimiento</strong>
          <button id="logoutButton" type="button">Cerrar sesión</button>
        </div>
      </aside>

      <main class="workspace">
        <header class="topbar">
          <div>
            <p class="eyebrow">DIGITEM Suite V1.3.3 · Pipeline Salud</p>
            <h1>Centro operativo interno.</h1>
          </div>
          <div class="user-pill"><span></span><strong id="userEmail">Cargando…</strong></div>
        </header>

        <section class="overview-panel" id="overviewPanel" data-panel-section="overview">
          <div class="hero-card">
            <div>
              <p class="eyebrow">Sistema comercial repetible</p>
              <h2>Convierte conversaciones en oportunidades sin perder el tono humano.</h2>
              <p>
                La Suite ordena el flujo completo de DIGITEM Salud: mensaje inicial, evaluación, recomendación, respuestas ante rechazos y seguimiento. Todo en una ruta clara para trabajar sin documentos dispersos.
              </p>
            </div>
            <div class="status-card">
              <span>Estado</span>
              <strong>Pipeline listo</strong>
              <p>Autenticación con Supabase activa. Los borradores se guardan localmente; el guardado en base de datos queda para la siguiente fase.</p>
              <div class="phase-pills" aria-label="Estados comerciales sugeridos">
                <button type="button" data-state="pendiente" class="phase-pill active">Pendiente</button>
                <button type="button" data-state="acepto" class="phase-pill">Aceptó</button>
                <button type="button" data-state="evaluado" class="phase-pill">Evaluado</button>
                <button type="button" data-state="recomendado" class="phase-pill">Recomendado</button>
                <button type="button" data-state="seguimiento" class="phase-pill">Seguimiento</button>
              </div>
            </div>
          </div>

          <div class="pipeline-board" aria-label="Pipeline comercial recomendado">
            <article class="pipeline-card" data-open-panel="prospecting"><span>01</span><p>Prospección</p><h3>Mensaje inicial</h3><small>Inicia la conversación con una perspectiva externa, no con una venta.</small></article>
            <article class="pipeline-card featured" data-open-panel="evaluation"><span>02</span><p>Evaluación</p><h3>Perspectiva Digital</h3><small>Califica visibilidad, confianza, claridad, WhatsApp y presencia profesional.</small></article>
            <article class="pipeline-card" data-open-panel="recommendation"><span>03</span><p>Recomendación</p><h3>Resumen para enviar</h3><small>Convierte hallazgos en un mensaje breve, útil y accionable.</small></article>
            <article class="pipeline-card" data-open-panel="objections"><span>04</span><p>Objeciones</p><h3>Respuestas suaves</h3><small>Agradece, objeta con respeto o deja la puerta abierta.</small></article>
            <article class="pipeline-card" data-open-panel="followup"><span>05</span><p>Seguimiento</p><h3>Lead frío/tibio/caliente</h3><small>Define el siguiente mensaje según el nivel de interés.</small></article>
          </div>

          <section class="dashboard-insights">
            <div>
              <p class="eyebrow">Cómo usarlo</p>
              <h2>Primero conversación. Después diagnóstico. Luego seguimiento.</h2>
            </div>
            <div class="insight-list">
              <article><strong>1</strong><span>Envía el script de prospección autorizado y marca el lead como pendiente.</span></article>
              <article><strong>2</strong><span>Si acepta, realiza la Perspectiva Digital Express con la guía interna.</span></article>
              <article><strong>3</strong><span>Genera el resumen profesional, copia y envía la recomendación.</span></article>
              <article><strong>4</strong><span>Si rechaza o duda, responde con objeciones suaves y define seguimiento.</span></article>
            </div>
          </section>
        </section>
      </main>

      <aside class="right-panel" id="rightPanel" aria-live="polite" aria-hidden="true">
        <div class="panel-shell">
          <header class="panel-header">
            <div>
              <p class="eyebrow" id="panelEyebrow">Suite</p>
              <h2 id="panelTitle">Selecciona un flujo</h2>
            </div>
            <button class="panel-close" id="closePanel" type="button" aria-label="Cerrar panel">×</button>
          </header>

          <div class="panel-body panel-content active" data-content="prospecting">
            <div class="content-intro">
              <p class="eyebrow">Paso 01 · Prospección</p>
              <h3>Script inicial autorizado.</h3>
              <p>Mensaje consultivo con emojis moderados para sonar humano, profesional y no invasivo.</p>
            </div>
            <div class="script-card" id="scriptText">
              <p>Hola, buena tarde 👋</p>
              <p>Soy Emma de DIGITEM-MX.</p>
              <p>Estaba conociendo algunos perfiles y sitios web de profesionales de la salud en la zona y me encontré con tu trabajo. Me pareció muy interesante la forma en que presentas tus servicios.</p>
              <p>Actualmente estamos ayudando a especialistas y consultorios a fortalecer su presencia digital para que las personas puedan entender mejor lo que hacen, generar confianza desde el primer contacto y encontrar una forma sencilla de comunicarse.</p>
              <p>Me gustaría compartirte algunas observaciones y oportunidades de mejora que identifiqué al revisar tu presencia digital. Es un ejercicio breve, sin costo y sin compromiso; simplemente una perspectiva externa que puede ayudarte a detectar áreas de oportunidad.</p>
              <p>🔎 Visibilidad en línea<br/>🤝 Confianza y presentación profesional<br/>💬 Facilidad de contacto para nuevos pacientes</p>
              <p>Si te interesa, con gusto te comparto un resumen breve.</p>
            </div>
            <div class="template-actions">
              <button class="primary-action" type="button" id="copyScriptButton">Copiar script</button>
              <button class="secondary-action" type="button" data-panel="objections">Ver respuestas si rechaza</button>
            </div>
          </div>

          <div class="panel-body panel-content" data-content="evaluation">
            <div class="content-intro">
              <p class="eyebrow">Paso 02 · Evaluación</p>
              <h3>Perspectiva Digital Express.</h3>
              <p>Se usa solo cuando el prospecto acepta recibir una revisión breve. Incluye una guía interna para mantener la conversación en 5 minutos.</p>
            </div>

            <details class="guide-box">
              <summary>Guía interna de evaluación de 5 minutos</summary>
              <div class="diagnostic-flow compact">
                <article><span>01</span><h4>Lo que ya hace bien</h4><p>Inicia con una observación positiva y real.</p></article>
                <article><span>02</span><h4>Oportunidad principal</h4><p>Explica una mejora concreta sin juzgar.</p></article>
                <article><span>03</span><h4>Impacto posible</h4><p>Conecta el hallazgo con visibilidad, confianza o contacto.</p></article>
                <article><span>04</span><h4>Recomendación puntual</h4><p>Propón una acción simple y alcanzable.</p></article>
                <article><span>05</span><h4>CTA suave</h4><p>Invita a conversar si quiere ver una propuesta inicial.</p></article>
              </div>
            </details>

            <div class="score-guide">
              <div><strong>0</strong><span>No existe</span></div>
              <div><strong>1</strong><span>Existe, pero débil</span></div>
              <div><strong>2</strong><span>Bien resuelto</span></div>
            </div>

            <form id="perspectiveForm" class="perspective-form">
              <div class="form-grid">
                <label><span>Negocio o profesional</span><input id="businessName" type="text" placeholder="Ej. Consultorio Dental Aurora" /></label>
                <label><span>Especialidad</span><input id="specialty" type="text" placeholder="Ej. Dentista, psicóloga, nutrióloga" /></label>
                <label><span>Ciudad / zona</span><input id="zone" type="text" placeholder="Ej. Coyoacán, CDMX" /></label>
                <label><span>Canal revisado</span><input id="channel" type="text" placeholder="Sitio web, Instagram, Google Business..." /></label>
              </div>

              <div class="score-form-grid">
                {scoreBlocks.map(([id, itemTitle, question]) => (
                  <label class="score-field">
                    <span>{itemTitle}</span>
                    <small>{question}</small>
                    <select id={id}>
                      <option value="0">0 · No existe</option>
                      <option value="1" selected>1 · Existe, pero débil</option>
                      <option value="2">2 · Bien resuelto</option>
                    </select>
                  </label>
                ))}
              </div>

              <label class="full-field"><span>Observaciones principales</span><textarea id="observations" rows="4" placeholder="Ej. Tiene buen contenido en Instagram, pero no hay una ruta clara para agendar ni una página posicionada por zona."></textarea></label>

              <div class="form-actions">
                <button type="submit">Generar resumen</button>
                <button type="button" class="secondary" id="saveDraftButton">Guardar borrador</button>
                <button type="button" class="ghost" id="clearFormButton">Limpiar</button>
              </div>
            </form>
          </div>

          <div class="panel-body panel-content" data-content="recommendation">
            <div class="content-intro">
              <p class="eyebrow">Paso 03 · Recomendación</p>
              <h3>Resumen para enviar al prospecto.</h3>
              <p>Después de evaluar, usa este mensaje como base. Se genera automáticamente desde Perspectiva Digital Express con tono consultivo, breve y listo para copiar.</p>
            </div>
            <aside class="result-card" id="resultCard">
              <span>Resultado</span>
              <strong id="resultScore">— / 10</strong>
              <p id="resultLevel">Completa la evaluación para generar una recomendación.</p>
              <textarea id="generatedMessage" rows="12" readonly placeholder="Aquí aparecerá el resumen listo para copiar después de evaluar."></textarea>
              <div class="template-actions">
                <button type="button" id="copyMessageButton">Copiar resumen</button>
                <button class="secondary-action" type="button" data-panel="followup">Ver seguimiento sugerido</button>
              </div>
            </aside>
          </div>

          <div class="panel-body panel-content" data-content="objections">
            <div class="content-intro">
              <p class="eyebrow">Paso 04 · Objeciones</p>
              <h3>Respuestas para rechazo, duda o falta de interés.</h3>
              <p>El objetivo no es presionar. Es cuidar la relación, responder con respeto y dejar una puerta abierta.</p>
            </div>
            <div class="objection-grid">
              <article class="template-card"><h4>No me interesa</h4><p>Muchas gracias por tomarte el tiempo de leer la información 🙌<br/><br/>Entiendo perfectamente. Mi intención era únicamente compartir una perspectiva externa que pudiera resultar útil para tu proyecto.<br/><br/>Te deseo mucho éxito y, si en algún momento necesitas una segunda opinión sobre tu presencia digital o algún tema relacionado con tecnología y crecimiento de tu práctica, con gusto estaré disponible.</p><button type="button" data-copy-template>Copiar</button></article>
              <article class="template-card"><h4>Ya tengo página web</h4><p>Excelente, eso ya representa una base importante 👏<br/><br/>De hecho, muchas de las personas con las que trabajamos ya cuentan con sitio web. Normalmente el enfoque no está en reemplazar lo que tienen, sino en identificar oportunidades para mejorar visibilidad, claridad o conversión dependiendo de sus objetivos actuales.<br/><br/>En cualquier caso, gracias por tu tiempo y por permitirme conocer un poco más de tu proyecto.</p><button type="button" data-copy-template>Copiar</button></article>
              <article class="template-card"><h4>No tengo presupuesto</h4><p>Lo entiendo perfectamente. Muchas veces el momento adecuado para invertir en presencia digital depende de las prioridades y objetivos de cada etapa.<br/><br/>Mi intención principal era compartir información que pudiera ser útil para tu proyecto, independientemente de que exista o no una colaboración inmediata.<br/><br/>Cuando consideres que es un buen momento para explorar opciones, con gusto podemos retomar la conversación.</p><button type="button" data-copy-template>Copiar</button></article>
              <article class="template-card"><h4>Ya tengo proveedor</h4><p>Qué bueno que ya cuentas con alguien que te apoya en esa parte 🙌<br/><br/>En ese caso, mi intención no sería reemplazarlo, sino ofrecerte una perspectiva externa sobre visibilidad, claridad y conversión si en algún momento te resulta útil comparar oportunidades.<br/><br/>Gracias por responderme y mucho éxito con tu proyecto.</p><button type="button" data-copy-template>Copiar</button></article>
              <article class="template-card"><h4>Lo voy a pensar</h4><p>Claro, tómate tu tiempo. La presencia digital funciona mejor cuando se alinea con el momento y los objetivos reales del proyecto.<br/><br/>Si te parece, puedo dejarte por aquí el resumen y más adelante, cuando lo consideres oportuno, retomamos la conversación con calma.</p><button type="button" data-copy-template>Copiar</button></article>
            </div>
          </div>

          <div class="panel-body panel-content" data-content="followup">
            <div class="content-intro">
              <p class="eyebrow">Paso 05 · Seguimiento</p>
              <h3>Mensajes según temperatura del lead.</h3>
              <p>Usa el seguimiento únicamente cuando exista una razón clara. Mejor pocos mensajes útiles que insistencia sin contexto.</p>
            </div>
            <div class="follow-grid">
              <article class="template-card"><h4>Lead frío · No respondió</h4><p>Hola, buena tarde 👋<br/><br/>Solo quería retomar mi mensaje anterior. La idea era compartirte una perspectiva breve sobre oportunidades digitales para tu práctica, sin costo ni compromiso.<br/><br/>Si no es prioridad en este momento, lo entiendo perfectamente. Gracias por tu tiempo.</p><button type="button" data-copy-template>Copiar</button></article>
              <article class="template-card"><h4>Lead tibio · Pidió información</h4><p>Gracias por responder 🙌<br/><br/>Te comparto una perspectiva breve y concreta. Me enfoqué en visibilidad, confianza y facilidad de contacto, porque suelen ser los tres puntos que más influyen cuando una persona decide escribir por WhatsApp.</p><button type="button" data-copy-template>Copiar</button></article>
              <article class="template-card"><h4>Lead caliente · Quiere saber costo</h4><p>Con gusto. Antes de hablar de costo, me gustaría confirmar qué nivel de solución tendría más sentido para tu caso: una landing esencial para ordenar presencia y contacto, o una estructura más robusta con SEO local y estrategia de conversión.<br/><br/>¿Te parece si te comparto ambas opciones de forma breve?</p><button type="button" data-copy-template>Copiar</button></article>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

      const SUPABASE_URL = 'https://cppplmloraanbnseqnka.supabase.co';
      const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNwcHBsbWxvcmFhbmJuc2VxbmthIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE3Mjk5MjYsImV4cCI6MjA5NzMwNTkyNn0.Nw80dCvEqd2jmYo5pR1oVSfpDV2EQxV46W0YKuoOPbE';
      const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const { data } = await supabase.auth.getSession();
      const session = data?.session;

      if (!session) {
        window.location.href = '/suite/login';
      } else {
        document.getElementById('userEmail').textContent = session.user?.email || 'usuario@digitem-mx.com';
      }

      document.getElementById('logoutButton')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        window.location.href = '/suite/login';
      });

      const panel = document.getElementById('rightPanel');
      const closePanel = document.getElementById('closePanel');
      const panelTitle = document.getElementById('panelTitle');
      const panelEyebrow = document.getElementById('panelEyebrow');
      const navItems = document.querySelectorAll('[data-panel]');
      const titles = {
        overview: ['Dashboard', 'Centro operativo'],
        prospecting: ['Script de prospección', 'Paso 01'],
        evaluation: ['Perspectiva Digital', 'Paso 02'],
        recommendation: ['Recomendación', 'Paso 03'],
        objections: ['Objeciones y respuestas', 'Paso 04'],
        followup: ['Seguimiento', 'Paso 05'],
      };

      function setActiveNav(key) {
        navItems.forEach((item) => item.classList.toggle('active', item.dataset.panel === key));
      }

      function openPanel(key) {
        if (key === 'overview') {
          panel.classList.remove('open');
          panel.setAttribute('aria-hidden', 'true');
          setActiveNav(key);
          return;
        }
        document.querySelectorAll('.panel-content').forEach((content) => {
          content.classList.toggle('active', content.dataset.content === key);
        });
        panelTitle.textContent = titles[key]?.[0] || 'DIGITEM Suite';
        panelEyebrow.textContent = titles[key]?.[1] || 'Suite';
        panel.classList.add('open');
        panel.setAttribute('aria-hidden', 'false');
        setActiveNav(key);
      }

      document.querySelectorAll('[data-panel]').forEach((button) => {
        button.addEventListener('click', () => openPanel(button.dataset.panel));
      });
      document.querySelectorAll('[data-open-panel]').forEach((card) => {
        card.addEventListener('click', () => openPanel(card.dataset.openPanel));
      });
      closePanel?.addEventListener('click', () => openPanel('overview'));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') openPanel('overview'); });

      const scoreFields = ['visibilityScore', 'trustScore', 'clarityScore', 'conversionScore', 'presenceScore'];
      const labels = {
        visibilityScore: 'Visibilidad local',
        trustScore: 'Confianza',
        clarityScore: 'Claridad del servicio',
        conversionScore: 'Contacto por WhatsApp',
        presenceScore: 'Presencia profesional',
      };

      const form = document.getElementById('perspectiveForm');
      const generatedMessage = document.getElementById('generatedMessage');
      const resultScore = document.getElementById('resultScore');
      const resultLevel = document.getElementById('resultLevel');

      function getLevel(score) {
        if (score <= 3) return 'Presencia digital débil';
        if (score <= 6) return 'Presencia funcional, pero con oportunidades claras';
        if (score <= 8) return 'Buena base digital';
        return 'Presencia sólida y lista para escalar';
      }

      function buildMessage() {
        const business = document.getElementById('businessName').value.trim() || 'tu presencia digital';
        const specialty = document.getElementById('specialty').value.trim() || 'profesional de salud';
        const zone = document.getElementById('zone').value.trim() || 'tu zona';
        const channel = document.getElementById('channel').value.trim() || 'tus canales digitales';
        const observations = document.getElementById('observations').value.trim();
        const scores = scoreFields.map((id) => Number(document.getElementById(id).value));
        const total = scores.reduce((acc, value) => acc + value, 0);
        const weakest = scoreFields.map((id, index) => ({ id, value: scores[index] })).sort((a, b) => a.value - b.value).slice(0, 2).map((item) => labels[item.id]);
        const level = getLevel(total);

        resultScore.textContent = `${total} / 10`;
        resultLevel.textContent = level;

        return `Hola, buena tarde 👋\n\nTe comparto la perspectiva breve que preparé sobre ${business}.\n\nRevisé principalmente ${channel}, considerando tu especialidad como ${specialty} en ${zone}.\n\nResultado general: ${total}/10 · ${level}.\n\nLo que observé con mayor oportunidad de mejora:\n• ${weakest.join('\n• ')}\n\n${observations ? `Observación principal:\n${observations}\n\n` : ''}Desde mi perspectiva, hay una oportunidad interesante para ordenar la presencia digital, explicar mejor los servicios y facilitar que una persona pueda contactarte con más confianza por WhatsApp.\n\nNo necesariamente se trata de crear algo complejo; muchas veces una estructura clara, enfocada en SEO local, confianza y contacto directo, puede ser suficiente para empezar a mejorar la experiencia del paciente.\n\nSi te interesa, con gusto puedo mostrarte una propuesta inicial muy breve para tu caso.`
      }

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        generatedMessage.value = buildMessage();
        openPanel('recommendation');
      });

      document.getElementById('copyMessageButton')?.addEventListener('click', async () => {
        if (!generatedMessage.value) generatedMessage.value = buildMessage();
        await navigator.clipboard.writeText(generatedMessage.value);
        document.getElementById('copyMessageButton').textContent = 'Copiado';
        setTimeout(() => (document.getElementById('copyMessageButton').textContent = 'Copiar resumen'), 1500);
      });

      document.getElementById('saveDraftButton')?.addEventListener('click', () => {
        const payload = {
          businessName: document.getElementById('businessName').value,
          specialty: document.getElementById('specialty').value,
          zone: document.getElementById('zone').value,
          channel: document.getElementById('channel').value,
          observations: document.getElementById('observations').value,
          scores: Object.fromEntries(scoreFields.map((id) => [id, document.getElementById(id).value])),
          generatedMessage: generatedMessage.value || buildMessage(),
          savedAt: new Date().toISOString(),
        };
        localStorage.setItem('digitem_perspective_draft', JSON.stringify(payload));
        alert('Borrador guardado localmente. En V1.4 lo guardaremos en Supabase.');
      });

      document.getElementById('clearFormButton')?.addEventListener('click', () => {
        form.reset();
        generatedMessage.value = '';
        resultScore.textContent = '— / 10';
        resultLevel.textContent = 'Completa la evaluación para generar una recomendación.';
      });

      const saved = localStorage.getItem('digitem_perspective_draft');
      if (saved) {
        try {
          const payload = JSON.parse(saved);
          ['businessName','specialty','zone','channel','observations'].forEach((id) => {
            if (payload[id]) document.getElementById(id).value = payload[id];
          });
          Object.entries(payload.scores || {}).forEach(([id, value]) => {
            if (document.getElementById(id)) document.getElementById(id).value = value;
          });
          if (payload.generatedMessage) generatedMessage.value = payload.generatedMessage;
        } catch {}
      }

      document.getElementById('copyScriptButton')?.addEventListener('click', async () => {
        const text = Array.from(document.querySelectorAll('#scriptText p')).map((p) => p.innerText).join('\n\n');
        await navigator.clipboard.writeText(text);
        document.getElementById('copyScriptButton').textContent = 'Copiado';
        setTimeout(() => (document.getElementById('copyScriptButton').textContent = 'Copiar script'), 1500);
      });

      document.querySelectorAll('[data-copy-template]').forEach((button) => {
        button.addEventListener('click', async () => {
          const article = button.closest('.template-card');
          const text = article.querySelector('p')?.innerText || '';
          await navigator.clipboard.writeText(text);
          button.textContent = 'Copiado';
          setTimeout(() => (button.textContent = 'Copiar'), 1500);
        });
      });

      document.querySelectorAll('[data-state]').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('[data-state]').forEach((item) => item.classList.remove('active'));
          button.classList.add('active');
          localStorage.setItem('digitem_pipeline_state', button.dataset.state || 'pendiente');
        });
      });

      const savedState = localStorage.getItem('digitem_pipeline_state');
      if (savedState) {
        document.querySelectorAll('[data-state]').forEach((item) => item.classList.toggle('active', item.dataset.state === savedState));
      }
    </script>
  </body>
</html>

