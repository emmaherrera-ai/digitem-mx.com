---
const title = 'DIGITEM Suite | Centro operativo interno';
const description = 'Centro operativo interno de DIGITEM-MX para gestionar prospectos, evaluaciones y seguimiento comercial por línea de negocio.';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  </head>
  <body>
    <div class="app" data-app>
      <aside class="sidebar">
        <div class="brand-block">
          <a href="/" class="brand">DIGITEM-MX</a>
          <p>Suite · V1.8.4</p>
        </div>

        <nav class="main-nav" aria-label="Navegación principal">
          <button class="nav-item active" type="button" data-view="dashboard">Dashboard</button>
          <div class="nav-label">Líneas de negocio</div>
          <button class="nav-item" type="button" data-line="salud">DIGITEM Salud</button>
          <button class="nav-item" type="button" data-line="corem">COREM</button>
          <button class="nav-item" type="button" data-line="it">DIGITEM IT</button>
          <div class="nav-label">Operación</div>
          <button class="nav-item" type="button" data-view="prospects">Prospectos</button>
          <button class="nav-item" type="button" data-view="knowledge">Base de conocimiento</button>
          <a class="nav-item" href="/suite/reset">Seguridad</a>
        </nav>

        <div class="session-card">
          <small>Sesión activa</small>
          <strong id="userEmail">Cargando…</strong>
          <button id="logoutButton" type="button">Cerrar sesión</button>
        </div>
      </aside>

      <main class="workspace">
        <header class="topbar">
          <div>
            <p class="eyebrow" id="contextEyebrow">Owner · Todas las líneas</p>
            <h1 id="pageTitle">Centro operativo DIGITEM.</h1>
          </div>
          <button class="primary" type="button" id="newProspectTop">+ Nuevo prospecto</button>
        </header>

        <section class="view active" data-view-section="dashboard">
          <div class="overview-grid">
            <article class="line-card" data-line="salud">
              <span>DIGITEM Salud</span>
              <h2>Prospección, evaluación y seguimiento para profesionales de salud.</h2>
              <div class="metrics"><p><strong id="saludCount">0</strong><small>prospectos</small></p><p><strong id="saludPending">0</strong><small>pendientes</small></p></div>
              <button type="button">Entrar a Salud</button>
            </article>
            <article class="line-card" data-line="corem">
              <span>COREM</span>
              <h2>Leads, demos y oportunidades para software empresarial.</h2>
              <div class="metrics"><p><strong id="coremCount">0</strong><small>leads</small></p><p><strong>V1.7</strong><small>por activar</small></p></div>
              <button type="button">Ver contexto</button>
            </article>
            <article class="line-card" data-line="it">
              <span>DIGITEM IT</span>
              <h2>Solicitudes, diagnósticos y servicios técnicos empresariales.</h2>
              <div class="metrics"><p><strong id="itCount">0</strong><small>solicitudes</small></p><p><strong>V1.7</strong><small>por activar</small></p></div>
              <button type="button">Ver contexto</button>
            </article>
          </div>

          <div class="dashboard-row">
            <section class="panel-card wide">
              <div class="section-head">
                <div>
                  <p class="eyebrow">Actividad reciente</p>
                  <h2>Seguimiento operativo.</h2>
                </div>
              </div>
              <div id="recentActivity" class="empty-state">Aún no hay actividad registrada.</div>
            </section>
            <section class="panel-card">
              <p class="eyebrow">Siguiente acción</p>
              <h2>Crear un prospecto real.</h2>
              <p>V1.4 guarda prospectos en Supabase. Empieza con DIGITEM Salud y después escalamos COREM e IT.</p>
              <button class="primary full" type="button" id="newProspectCard">Nuevo prospecto</button>
            </section>
          </div>
        </section>

        <section class="view" data-view-section="prospects">
          <div class="prospects-layout">
            <aside class="prospect-list-card">
              <div class="section-head compact">
                <div>
                  <p class="eyebrow" id="prospectLineLabel">DIGITEM Salud</p>
                  <h2>Prospectos</h2>
                </div>
              </div>
              <div class="filters">
                <button class="filter active" data-status="all" type="button">Todos</button>
                <button class="filter" data-status="prospeccion" type="button">Prospección</button>
                <button class="filter" data-status="evaluacion" type="button">Evaluación</button>
                <button class="filter" data-status="seguimiento" type="button">Seguimiento</button>
              </div>
              <div id="prospectsList" class="prospects-list"></div>
            </aside>

            <section class="prospect-workspace" id="prospectWorkspace">
              <div class="empty-prospect">
                <p class="eyebrow">Sin prospecto seleccionado</p>
                <h2>Selecciona o crea una oportunidad.</h2>
                <p>El flujo contextual aparecerá aquí: prospección, evaluación, recomendación, objeciones y seguimiento.</p>
                <button class="primary" type="button" id="newProspectEmpty">Crear prospecto</button>
              </div>
            </section>

          </div>
        </section>

        <section class="view" data-view-section="knowledge">
          <div class="knowledge-home">
            <p class="eyebrow">Base de conocimiento</p>
            <h2>Recursos operativos por línea de negocio.</h2>
            <div class="knowledge-grid">
              <article><span>Salud</span><h3>Perspectiva Digital Express</h3><p>Scripts, evaluación, recomendación, objeciones y seguimiento.</p></article>
              <article><span>COREM</span><h3>Por estructurar</h3><p>Demos, diagnóstico operativo y propuesta modular.</p></article>
              <article><span>IT</span><h3>Por estructurar</h3><p>Diagnóstico técnico, historial de equipos y mantenimiento.</p></article>
            </div>
          </div>
        </section>
      </main>
    </div>

    <dialog id="prospectDialog" class="dialog">
      <form id="prospectForm" class="dialog-card" method="dialog">
        <div class="dialog-head">
          <div><p class="eyebrow">Nueva oportunidad</p><h2>Crear prospecto</h2></div>
          <button type="button" class="icon-button" id="closeProspectDialog">×</button>
        </div>
        <div class="form-grid">
          <label><span>Nombre</span><input id="pName" required placeholder="Ej. Fernanda Alba" /></label>
          <label><span>Empresa / consultorio</span><input id="pBusiness" placeholder="Ej. Consultorio psicológico" /></label>
          <label><span>Línea de negocio</span><select id="pLine"><option value="salud">DIGITEM Salud</option><option value="corem">COREM</option><option value="it">DIGITEM IT</option></select></label>
          <label><span>WhatsApp</span><input id="pWhatsapp" placeholder="55..." /></label>
          <label><span>Correo</span><input id="pEmail" type="email" placeholder="correo@dominio.com" /></label>
          <label><span>Instagram</span><input id="pInstagram" placeholder="@usuario" /></label>
          <label><span>Sitio web</span><input id="pWebsite" placeholder="https://..." /></label>
          <label><span>Ciudad / zona</span><input id="pCity" placeholder="CDMX, Coyoacán..." /></label>
          <label><span>Fuente</span><input id="pSource" placeholder="Instagram, Google, referido..." /></label>
          <label class="full"><span>Notas</span><textarea id="pNotes" rows="3" placeholder="Contexto inicial del prospecto"></textarea></label>
        </div>
        <button class="primary full" type="submit">Guardar prospecto</button>
        <p class="form-message" id="prospectMessage"></p>
      </form>
    </dialog>

    <dialog id="kbDialog" class="dialog kb-drawer">
      <article class="dialog-card kb-dialog-card">
        <div class="dialog-head">
          <div><p class="eyebrow" id="kbEyebrow">Base de conocimiento</p><h2 id="kbTitle">Recurso</h2></div>
          <button type="button" class="icon-button" id="closeKbDialog">×</button>
        </div>
        <div id="kbContent" class="kb-content"></div>
      </article>
    </dialog>



    <dialog id="deleteDialog" class="dialog danger-dialog">
      <form id="deleteForm" class="dialog-card danger-card" method="dialog">
        <div class="dialog-head">
          <div><p class="eyebrow" id="deleteEyebrow">Confirmación segura</p><h2 id="deleteTitle">Eliminar registro</h2></div>
          <button type="button" class="icon-button" id="closeDeleteDialog">×</button>
        </div>
        <p class="delete-warning" id="deleteWarning">Esta acción no se puede deshacer.</p>
        <div class="delete-confirm-grid">
          <label id="deletePhraseWrap"><span id="deletePhraseLabel">Escribe la frase de confirmación</span><input id="deletePhraseInput" autocomplete="off" /></label>
          <label id="deleteNameWrap"><span id="deleteNameLabel">Escribe el nombre exacto</span><input id="deleteNameInput" autocomplete="off" /></label>
        </div>
        <div class="delete-actions">
          <button class="ghost-button" type="button" id="cancelDeleteDialog">Cancelar</button>
          <button class="danger-submit" type="submit" id="confirmDeleteButton" disabled>Eliminar definitivamente</button>
        </div>
        <p class="form-message" id="deleteMessage"></p>
      </form>
    </dialog>

    <script is:inline src="/suite.js"></script>

  </body>
</html>

<style is:global>
  :root{
    --teal:#11999E;
    --teal-2:#0E7F84;
    --orange:#E07422;
    --ink:#0F1F2E;
    --muted:#667585;
    --soft:#F5FAFA;
    --soft-2:#EEF8F8;
    --line:rgba(17,153,158,.16);
    --line-strong:rgba(17,153,158,.28);
    --card:#FFFFFF;
    --shadow:0 22px 70px rgba(15,31,46,.08);
    --shadow-hover:0 30px 90px rgba(15,31,46,.13);
    --radius:28px;
    --ease:cubic-bezier(.22,1,.36,1);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:radial-gradient(circle at 8% 4%,rgba(17,153,158,.12),transparent 32%),linear-gradient(135deg,#fff 0%,#f7fbfb 50%,#f2f8f8 100%);color:var(--ink);min-height:100svh}
  button,input,select,textarea{font:inherit}
  button{cursor:pointer}
  .app{min-height:100svh;display:grid;grid-template-columns:286px minmax(0,1fr)}

  .sidebar{position:sticky;top:0;height:100svh;padding:24px 20px;display:flex;flex-direction:column;gap:22px;background:rgba(255,255,255,.78);border-right:1px solid var(--line);backdrop-filter:blur(24px)}
  .brand-block{padding:4px 4px 14px;border-bottom:1px solid rgba(15,31,46,.08)}
  .brand{display:inline-block;font-size:1.34rem;font-weight:950;letter-spacing:-.06em;text-decoration:none;background:linear-gradient(90deg,var(--teal),#7B886A,var(--orange));-webkit-background-clip:text;background-clip:text;color:transparent}
  .brand-block p{margin:4px 0 0;color:var(--muted);font-weight:850;font-size:.84rem}
  .main-nav{display:grid;gap:8px}.nav-label{margin:18px 8px 6px;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:#9AA8B6;font-weight:950}.nav-item{width:100%;border:0;background:transparent;color:#415163;border-radius:18px;padding:14px 16px;text-align:left;text-decoration:none;font-weight:900;transition:background .35s var(--ease), color .35s var(--ease), transform .35s var(--ease), box-shadow .35s var(--ease)}.nav-item:hover{background:rgba(17,153,158,.08);color:var(--teal);transform:translateX(2px)}.nav-item.active{background:linear-gradient(135deg,rgba(17,153,158,.13),rgba(255,255,255,.96));color:var(--teal);box-shadow:inset 0 0 0 1px rgba(17,153,158,.14)}
  .session-card{margin-top:auto;border:1px solid var(--line);border-radius:24px;background:rgba(255,255,255,.88);padding:16px;box-shadow:0 18px 45px rgba(15,31,46,.06)}.session-card small{display:block;color:var(--teal);font-size:.68rem;text-transform:uppercase;letter-spacing:.16em;font-weight:950}.session-card strong{display:block;margin:8px 0 14px;color:#334155;overflow:hidden;text-overflow:ellipsis}.session-card button{width:100%;border:0;border-radius:16px;padding:12px;background:#111827;color:#fff;font-weight:950;transition:.35s var(--ease)}.session-card button:hover{transform:translateY(-2px);box-shadow:0 16px 35px rgba(17,24,39,.18)}

  .workspace{padding:32px clamp(22px,4vw,56px) 48px}.topbar{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:26px}.eyebrow{margin:0 0 10px;color:var(--teal);font-weight:950;letter-spacing:.16em;text-transform:uppercase;font-size:.72rem}.topbar h1{margin:0;font-size:clamp(2.4rem,4.8vw,5rem);line-height:.9;letter-spacing:-.09em}.primary,button.primary,.line-card button,.panel-card button,.action-buttons button{border:0;border-radius:18px;background:var(--teal);color:#fff;font-weight:950;padding:14px 20px;box-shadow:0 16px 38px rgba(17,153,158,.18);transition:transform .35s var(--ease), box-shadow .35s var(--ease), background .35s var(--ease)}.primary:hover,.line-card button:hover,.panel-card button:hover,.action-buttons button:hover{transform:translateY(-2px);background:var(--teal-2);box-shadow:0 22px 48px rgba(17,153,158,.24)}.full{width:100%}

  .view{display:none}.view.active{display:block;animation:fadeUp .45s var(--ease) both}@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  .overview-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.line-card,.panel-card,.prospect-list-card,.prospect-workspace,.knowledge-rail,.tool-card,.knowledge-home{border:1px solid var(--line);border-radius:var(--radius);background:rgba(255,255,255,.9);box-shadow:var(--shadow);backdrop-filter:blur(18px)}.line-card{padding:26px;transition:.45s var(--ease);position:relative;overflow:hidden}.line-card:before{content:"";position:absolute;inset:auto -20% -40% 30%;height:120px;background:radial-gradient(circle,rgba(17,153,158,.14),transparent 65%);opacity:.6}.line-card:hover{transform:translateY(-6px);border-color:var(--line-strong);box-shadow:var(--shadow-hover)}.line-card span{position:relative;color:var(--teal);font-size:.72rem;font-weight:950;text-transform:uppercase;letter-spacing:.14em}.line-card h2{position:relative;font-size:1.5rem;line-height:1.06;letter-spacing:-.06em}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.metrics p{margin:0;border:1px solid var(--line);border-radius:18px;padding:13px;background:linear-gradient(180deg,#fff,#f8fbfb)}.metrics strong{display:block;font-size:1.55rem}.metrics small{color:var(--muted);font-weight:850}.dashboard-row{display:grid;grid-template-columns:1.25fr .75fr;gap:18px;margin-top:18px}.panel-card{padding:26px}.panel-card h2{font-size:2rem;letter-spacing:-.06em;margin:.2rem 0}.panel-card p{color:var(--muted);line-height:1.65}.activity-row{display:grid;grid-template-columns:1fr 1.3fr auto;gap:12px;padding:14px;border-bottom:1px solid rgba(15,31,46,.07)}.activity-row span{color:var(--teal);font-weight:950}.empty-state,.empty-list{color:var(--muted);padding:20px;border:1px dashed var(--line);border-radius:20px;background:#fbfdfd}

  .prospects-layout{display:grid;grid-template-columns:320px minmax(0,1fr);gap:22px;align-items:start}.prospect-list-card{padding:18px;min-height:calc(100svh - 150px)}.section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.section-head h2{margin:.2rem 0 0;letter-spacing:-.06em}.filters{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}.filter{border:1px solid var(--line);background:#fff;color:var(--muted);border-radius:999px;padding:8px 11px;font-weight:900;font-size:.78rem;transition:.3s var(--ease)}.filter:hover,.filter.active{background:rgba(17,153,158,.1);color:var(--teal);border-color:var(--line-strong)}.prospects-list{display:grid;gap:10px}.prospect-item{width:100%;text-align:left;border:1px solid var(--line);background:linear-gradient(180deg,#fff,#fbfdfd);border-radius:20px;padding:15px;display:grid;gap:5px;transition:.35s var(--ease)}.prospect-item:hover{transform:translateY(-2px);box-shadow:0 16px 35px rgba(15,31,46,.08)}.prospect-item.active{background:#fff;border-color:rgba(17,153,158,.42);box-shadow:0 18px 42px rgba(17,153,158,.11)}.prospect-item strong{letter-spacing:-.03em}.prospect-item span,.prospect-item small{color:var(--muted)}

  .prospect-workspace{min-height:calc(100svh - 150px);padding:20px;background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(251,253,253,.9));overflow:hidden}.empty-prospect{text-align:center;display:grid;place-items:center;align-content:center;min-height:60vh;padding:28px}.empty-prospect h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.08em}.prospect-profile-shell{display:grid;gap:16px;margin-bottom:18px}.profile-hero{border:1px solid var(--line);border-radius:32px;background:linear-gradient(135deg,#fff 0%,#f8fdfd 60%,rgba(17,153,158,.06) 100%);padding:26px;box-shadow:0 22px 60px rgba(15,31,46,.07);display:flex;justify-content:space-between;gap:24px;align-items:flex-start}.profile-hero h2{font-size:clamp(2.2rem,4vw,4.5rem);line-height:.92;letter-spacing:-.085em;margin:.1rem 0}.profile-hero p{color:var(--muted);margin:.2rem 0}.profile-controls{display:grid;gap:10px;min-width:260px}.status-label span{font-size:.68rem;text-transform:uppercase;letter-spacing:.15em;color:#94a3b8;font-weight:950}.ghost-button{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:16px;padding:12px 14px;font-weight:950;box-shadow:0 12px 30px rgba(15,31,46,.04);transition:.35s var(--ease)}.ghost-button:hover{border-color:var(--line-strong);background:#f8fbfb;transform:translateY(-1px)}

  .progress-strip{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.progress-step{border:1px solid var(--line);background:#fff;border-radius:20px;padding:13px;text-align:left;font-size:.78rem;font-weight:950;color:var(--muted);transition:.35s var(--ease);position:relative;overflow:hidden}.progress-step span{display:block;color:#94a3b8;font-size:.66rem;letter-spacing:.13em;margin-bottom:5px}.progress-step:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(15,31,46,.06)}.progress-step.active{background:linear-gradient(135deg,rgba(17,153,158,.11),#fff);border-color:rgba(17,153,158,.32);color:var(--teal)}
  .profile-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:14px}.profile-panel{border:1px solid var(--line);border-radius:26px;background:#fff;padding:21px;box-shadow:0 18px 50px rgba(15,31,46,.06)}.next-panel h3{font-size:2rem;line-height:1;letter-spacing:-.06em;margin:.1rem 0}.next-panel p{color:var(--muted);line-height:1.6}.contact-list{display:grid;grid-template-columns:1fr 1fr;gap:10px}.contact-list p{margin:0;background:#f8fbfb;border:1px solid var(--line);border-radius:18px;padding:12px}.contact-list span{display:block;color:#94a3b8;font-size:.68rem;font-weight:950;text-transform:uppercase;letter-spacing:.12em}.contact-list strong{font-size:.9rem;overflow-wrap:anywhere}

  .tool-card{padding:26px;margin-bottom:16px}.tool-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.workflow-card h3{font-size:clamp(2rem,4vw,3.45rem);line-height:.95;letter-spacing:-.08em;margin:.2rem 0}.tool-intro,.helper-note{color:var(--muted);line-height:1.6}.tool-card textarea{margin:14px 0;min-height:220px;width:100%;border-radius:22px;background:linear-gradient(180deg,#f9fcfc,#fff);border:1px solid var(--line);padding:18px;line-height:1.55;color:#263443;resize:vertical}.action-buttons{display:flex;flex-wrap:wrap;gap:10px}.action-buttons button:nth-child(2),.tool-card button:nth-of-type(2){background:#111827}.action-buttons button:nth-child(3){background:#fff;color:var(--orange);box-shadow:inset 0 0 0 1px rgba(224,116,34,.22)}

  .survey-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:14px 0}.score-card{border:1px solid var(--line);border-radius:22px;background:#fbfdfd;padding:14px;margin:0;display:grid;gap:10px}.score-card-head{display:grid;gap:3px}.score-card legend{font-weight:950;margin:0;font-size:1rem}.score-card small{color:var(--muted);line-height:1.35}.score-card label{display:grid;grid-template-columns:auto auto 1fr;gap:7px;align-items:center;padding:8px 9px;border-radius:14px;color:var(--muted);font-size:.82rem}.score-card label span{font-weight:950;color:var(--ink)}.score-card label em{font-style:normal}.score-card input{width:auto}.score-card label:has(input:checked){background:#fff;color:var(--ink);box-shadow:0 8px 22px rgba(15,31,46,.05)}
  .stack{display:grid;gap:12px}.mini-template{border:1px solid var(--line);border-radius:22px;background:#fbfdfd;padding:18px}.mini-template h4{margin:0 0 8px}.mini-template p{color:var(--muted);line-height:1.55}.mini-template button{margin-top:6px}

