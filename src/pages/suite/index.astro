  /* V1.4.12 — objection copy buttons polished */
  .mini-template .copy-button {
    appearance: none;
    border: 0 !important;
    width: auto;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
    padding: 11px 15px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--teal), #0f7f83) !important;
    color: #ffffff !important;
    font-size: .82rem;
    font-weight: 950;
    letter-spacing: -.01em;
    line-height: 1;
    box-shadow: 0 14px 32px rgba(17,153,158,.18) !important;
    transition: transform .35s var(--ease), box-shadow .35s var(--ease), background .35s var(--ease), opacity .35s var(--ease);
  }
  .mini-template .copy-button::before {
    content: "Copiar";
    width: 18px;
    height: 18px;
    border-radius: 7px;
    display: inline-grid;
    place-items: center;
    font-size: 0;
    background: rgba(255,255,255,.22);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.18);
  }
  .mini-template .copy-button::after {
    content: "";
    width: 6px;
    height: 10px;
    border-right: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(45deg) translate(-1px,-1px);
    opacity: .92;
    position: absolute;
    margin-left: -9999px;
  }
  .mini-template .copy-button:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #0f7f83, var(--teal)) !important;
    box-shadow: 0 20px 44px rgba(17,153,158,.24) !important;
  }
  .mini-template .copy-button:active {
    transform: translateY(0);
    opacity: .9;
  }
  .mini-template {
    position: relative;
  }
  @media(max-width:760px){
    .mini-template .copy-button {
      width: 100%;
      padding: 13px 15px;
      border-radius: 16px;
    }
  }


