    .topbar .primary { width: 100%; padding: 13px 16px; border-radius: 16px; }
    .line-card, .panel-card, .prospect-list-card, .prospect-workspace, .tool-card, .profile-panel, .presence-summary { border-radius: 22px; }
    .prospect-list-card { min-height: auto; }
    .filters { display: flex; flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 4px; scrollbar-width: none; }
    .filters::-webkit-scrollbar { display: none; }
    .filter { flex: 0 0 auto; }
    .prospects-list { max-width: 100%; }
    .prospect-item { padding: 13px; }
    .empty-prospect { min-height: auto; padding: 26px 14px; }
    .profile-hero { width: 100%; padding: 16px; gap: 14px; }
    .profile-hero h2 { font-size: clamp(2rem, 11vw, 2.6rem); line-height: .95; }
    .profile-controls { width: 100%; }
    .profile-controls select, .profile-controls button { width: 100%; }
    .progress-strip { width: 100%; margin: 4px 0; padding-bottom: 6px; scroll-snap-type: x mandatory; }
