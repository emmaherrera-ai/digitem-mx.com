    .compact-score-options { grid-template-columns: 1fr !important; }
    .compact-score-options label { justify-content: flex-start; text-align: left; }
    .score-card textarea { width: 100%; min-height: 70px; }
    .presence-head { gap: 8px; }
    .presence-head h4 { font-size: 1.15rem; }
    .score-total strong { font-size: 2rem; }
    .generated-details summary { padding: 12px; }
