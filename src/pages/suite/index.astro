    .client-steps { grid-template-columns: 1fr; }
    .dialog { width: 100%; max-width: 100%; padding: 8px; margin: 0; }
    .dialog-card { width: 100%; max-width: 100%; border-radius: 24px; padding: 16px; }
    .dialog-head h2 { font-size: 2rem; }
