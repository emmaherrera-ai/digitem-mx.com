  /* V1.4.11 — mobile/small-screen stability */
  html, body { width: 100%; max-width: 100%; overflow-x: hidden; }
  .app, .workspace, .view, .overview-grid, .dashboard-row, .prospects-layout,
  .prospect-list-card, .prospect-workspace, .prospect-profile-shell, .profile-grid,
  .profile-panel, .tool-card, .workflow-card, .evaluation-card, .presence-summary,
  .dialog-card, .kb-content { min-width: 0; max-width: 100%; }
  .script-box, textarea, input, select, .contact-list strong, .prospect-item,
  .next-panel h3, .profile-hero h2, .tool-card h3, .panel-card h2 { overflow-wrap: anywhere; word-break: normal; }

  @media (max-width: 760px) {
