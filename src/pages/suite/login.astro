---
const title = 'DIGITEM Suite | Acceso privado';
const description = 'Acceso privado a DIGITEM Suite para manuales, scripts, plantillas, clientes y seguimiento operativo.';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="auth-shell">
      <section class="auth-visual" aria-label="DIGITEM Suite">
        <a class="brand" href="/" aria-label="Volver a DIGITEM-MX">DIGITEM-MX</a>
        <div class="brand-system" aria-hidden="true">
          <span class="shape triangle"></span>
          <span class="shape line"></span>
          <span class="shape circle"></span>
        </div>
        <div class="visual-copy">
          <p class="eyebrow">Suite interna</p>
          <h1>DIGITEM Suite</h1>
          <p>Centro operativo interno para procesos, manuales, clientes, scripts, seguimiento y crecimiento de DIGITEM-MX.</p>
        </div>
        <div class="suite-chips" aria-label="Áreas internas de DIGITEM Suite">
          <span>Manuales</span>
          <span>Scripts</span>
          <span>Clientes</span>
          <span>Seguimientos</span>
          <span>Plantillas</span>
        </div>
      </section>

      <section class="auth-card" aria-label="Acceso a DIGITEM Suite">
        <div class="card-top">
          <p class="eyebrow">Acceso privado</p>
          <h2>Iniciar sesión</h2>
          <p>Acceso restringido a usuarios autorizados.</p>
        </div>

        <form id="loginForm" class="auth-form">
          <label>
            <span>Correo</span>
            <input id="email" type="email" placeholder="Correo" autocomplete="email" required />
          </label>
          <label>
            <span>Contraseña</span>
            <input id="password" type="password" placeholder="Contraseña" autocomplete="current-password" required />
          </label>
          <button type="submit">Acceder</button>
        </form>

        <div class="actions-row">
          <a href="/suite/reset">¿Olvidaste tu contraseña?</a>
          <a href="/">Volver a DIGITEM-MX</a>
        </div>

        <p id="authMessage" class="auth-message" role="status"></p>
      </section>
    </main>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

      const SUPABASE_URL = 'https://cppplmloraanbnseqnka.supabase.co';
      const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNwcHBsbWxvcmFhbmJuc2VxbmthIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE3Mjk5MjYsImV4cCI6MjA5NzMwNTkyNn0.Nw80dCvEqd2jmYo5pR1oVSfpDV2EQxV46W0YKuoOPbE';
      const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const form = document.getElementById('loginForm');
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      const message = document.getElementById('authMessage');
      const submitButton = form?.querySelector('button[type="submit"]');

      const { data } = await supabase.auth.getSession();
      if (data?.session) window.location.href = '/suite/';

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        message.textContent = '';
        message.className = 'auth-message';
        submitButton.disabled = true;
        submitButton.textContent = 'Validando acceso…';

        const email = emailInput.value.trim();
        const password = passwordInput.value;
        const { error } = await supabase.auth.signInWithPassword({ email, password });

        if (error) {
          message.textContent = 'No pudimos iniciar sesión. Verifica tus credenciales o confirma que tu usuario esté autorizado.';
          message.classList.add('error');
          submitButton.disabled = false;
          submitButton.textContent = 'Acceder';
          return;
        }

        message.textContent = 'Acceso correcto. Redirigiendo…';
        message.classList.add('success');
        window.location.href = '/suite/';
      });
    </script>
  </body>
</html>

<style>
  :root {
    --orange: #E07422;
    --teal: #11999E;
    --soft-teal: #dff2f2;
    --light: #F0F0F0;
    --dark: #333333;
    --white: #FFFFFF;
    --ink: #0f2430;
    --muted: #66737d;
    --line: rgba(17, 24, 39, .11);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100svh;
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background:
      radial-gradient(circle at 10% 8%, rgba(17,153,158,.11), transparent 32%),
      radial-gradient(circle at 90% 14%, rgba(224,116,34,.09), transparent 28%),
      linear-gradient(135deg, #ffffff 0%, #f8fbfb 52%, #eef8f8 100%);
  }
  a { color: inherit; text-decoration: none; }
  .auth-shell {
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(350px, .68fr);
    gap: clamp(22px, 4vw, 72px);
    align-items: center;
    width: min(1200px, calc(100% - 32px));
    margin: 0 auto;
    padding: clamp(18px, 5vw, 60px) 0;
  }
  .auth-visual, .auth-card {
    border: 1px solid rgba(255,255,255,.76);
    background: rgba(255,255,255,.70);
    backdrop-filter: blur(24px);
    box-shadow: 0 30px 90px rgba(17,24,39,.09);
  }
  .auth-visual {
    min-height: min(680px, calc(100svh - 78px));
    border-radius: 42px;
    padding: clamp(30px, 5vw, 58px);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .auth-visual::before {
    content: "";
    position: absolute;
    inset: auto -18% -28% auto;
    width: 600px;
    height: 600px;
    border-radius: 999px;
    background: rgba(17,153,158,.075);
    border: 1px solid rgba(17,153,158,.08);
  }
  .brand {
    width: max-content;
    font-weight: 900;
    letter-spacing: -.07em;
    font-size: clamp(1.45rem, 2.2vw, 2.05rem);
    background: linear-gradient(100deg, var(--teal), #176b78 44%, var(--orange));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    position: relative;
    z-index: 2;
  }
  .brand-system {
    position: absolute;
    top: clamp(42px, 7vw, 84px);
    right: clamp(28px, 5vw, 72px);
    display: flex;
    align-items: end;
    gap: 16px;
    opacity: .9;
  }
  .shape { display: block; }
  .triangle {
    width: 0;
    height: 0;
    border-left: 42px solid transparent;
    border-right: 42px solid transparent;
    border-bottom: 82px solid var(--teal);
  }
  .line { width: 24px; height: 82px; background: rgba(17,153,158,.22); }
  .circle { width: 82px; height: 82px; border-radius: 999px; background: var(--orange); }
  .visual-copy { position: relative; z-index: 2; max-width: 680px; margin-top: 110px; }
  .eyebrow {
    margin: 0 0 14px;
    color: var(--teal);
    text-transform: uppercase;
    letter-spacing: .16em;
    font-size: .72rem;
    font-weight: 900;
  }
  h1, h2, p { margin-top: 0; }
  h1 {
    margin-bottom: 22px;
    font-size: clamp(3.6rem, 8vw, 7.2rem);
    line-height: .88;
    letter-spacing: -.085em;
  }
  .visual-copy p:not(.eyebrow), .card-top p:not(.eyebrow) {
    color: var(--muted);
    line-height: 1.75;
    font-size: clamp(1rem, 1.25vw, 1.15rem);
    max-width: 580px;
  }
  .suite-chips {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 540px;
  }
  .suite-chips span {
    border: 1px solid rgba(17,153,158,.16);
    background: rgba(255,255,255,.70);
    color: #24666a;
    border-radius: 999px;
    padding: 10px 14px;
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: -.01em;
  }
  .auth-card { border-radius: 32px; padding: clamp(28px, 4vw, 44px); }
  .card-top h2 { margin-bottom: 12px; font-size: clamp(2rem, 3.6vw, 3.05rem); line-height: .96; letter-spacing: -.07em; }
  .auth-form { display: grid; gap: 16px; margin-top: 28px; }
  label { display: grid; gap: 8px; font-weight: 800; font-size: .9rem; color: #25313a; }
  input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 15px;
    font: inherit;
    background: #fff;
    transition: border-color .32s ease, box-shadow .32s ease;
  }
  input::placeholder { color: rgba(102,115,125,.54); }
  input:focus { outline: none; border-color: rgba(17,153,158,.56); box-shadow: 0 0 0 5px rgba(17,153,158,.10); }
  button {
    border: 0;
    border-radius: 14px;
    padding: 14px 18px;
    font: inherit;
    font-weight: 850;
    color: white;
    cursor: pointer;
    background: var(--teal);
    box-shadow: none;
    transition: transform .32s ease, background-color .32s ease, box-shadow .32s ease;
  }
  button:hover { transform: translateY(-1px); background: #0f858a; box-shadow: 0 12px 30px rgba(17,153,158,.18); }
  button:disabled { cursor: wait; opacity: .72; transform: none; }
  .actions-row { margin-top: 18px; display: flex; justify-content: space-between; gap: 14px; flex-wrap: wrap; font-size: .88rem; font-weight: 750; }
  .actions-row a { color: #126f78; }
  .auth-message { margin: 18px 0 0; min-height: 24px; color: var(--muted); font-weight: 800; line-height: 1.55; }
  .auth-message.error { color: #b42318; }
  .auth-message.success { color: #126f78; }
  @media (max-width: 920px) {
    .auth-shell { grid-template-columns: 1fr; width: min(620px, calc(100% - 28px)); }
    .auth-visual { display: none; }
    .auth-card { padding: 34px 24px; }
    .card-top { text-align: left; }
  }
  @media (max-width: 620px) {
    .auth-shell { padding: 18px 0 34px; }
    .auth-card { border-radius: 26px; box-shadow: 0 22px 60px rgba(17,24,39,.08); }
    .card-top h2 { font-size: clamp(2rem, 12vw, 2.8rem); }
    .actions-row { flex-direction: column; gap: 10px; }
  }
</style>
