div>\n            </div>\n\n            <div class=\"mt-6 bg-gradient-to-r from-aurora-mint-light/70 to-aurora-purple-light/50 border border-aurora-mint/10 rounded-2xl p-4 text-xs space-y-1\">\n              <span class=\"font-extrabold uppercase text-[10px] tracking-wider text-aurora-mint block\">Mensaje listo para WhatsApp:</span>\n              <p id=\"finalMsgPreview\" class=\"italic text-slate-600 leading-relaxed font-semibold\">Cargando formato de mensaje...</p>\n            </div>\n\n            <button type=\"button\" onclick=\"sendFinalWhatsApp()\" class=\"mt-5 w-full bg-emerald-500 hover:bg-emerald-600 text-white py-4 rounded-2xl font-extrabold text-sm shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/30 transition-all flex items-center justify-center gap-2\">\n              <svg class=\"w-5 h-5 fill-white\" viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.73-1.45L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.968C16.628 1.97 14.155.945 11.53.945 6.096.945 1.673 5.313 1.67 10.742c-.001 1.69.444 3.34 1.288 4.793l-.999 3.648 3.733-.967-.044.024-.002.016zm12.115-4.504c-.312-.156-1.847-.91-2.128-1.012-.282-.101-.487-.152-.692.157-.205.308-.795 1.011-.974 1.213-.18.203-.36.228-.672.072-.312-.156-1.318-.486-2.51-1.549-.928-.828-1.555-1.85-1.737-2.162-.18-.312-.019-.481.137-.636.141-.14.312-.364.468-.546.156-.182.208-.312.312-.52.104-.208.052-.39-.026-.546-.078-.156-.692-1.666-.949-2.285-.25-.601-.525-.519-.718-.529l-.615-.01c-.205 0-.538.078-.82.384-.282.308-1.077 1.053-1.077 2.568 0 1.515 1.102 2.981 1.256 3.184.154.203 2.169 3.313 5.253 4.643.734.317 1.307.507 1.753.649.738.234 1.41.201 1.942.122.593-.088 1.847-.755 2.103-1.447.256-.692.256-1.289.18-1.417-.078-.129-.283-.207-.595-.363z\"/></svg>\n              Enviar por WhatsApp\n            </button>\n            <p class=\"mt-3 text-[11px] text-slate-400 text-center font-medium\">Demo ficticia: el formulario no guarda información; solo muestra el flujo de contacto.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer de Demo Ficticia -->\n  <footer class=\"bg-slate-950 border-t border-slate-900 py-12 px-4 sm:px-6 lg:px-8 text-slate-400 text-sm\">\n    <div class=\"max-w-7xl mx-auto space-y-8\">\n      <div class=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-6 pb-8 border-b border-slate-900\">\n        <div>\n          <strong class=\"text-white font-extrabold block text-base\">Clínica Dental Aurora</strong>\n          <span class=\"text-xs text-slate-500 block\">Demo técnica de conversión local para odontólogos</span>\n        </div>\n        <div class=\"flex flex-wrap gap-6 text-xs font-bold text-slate-500\">\n          <a href=\"#hero\" class=\"hover:text-white transition\">Inicio</a>\n          <a href=\"#confianza\" class=\"hover:text-white transition\">Confianza</a>\n          <a href=\"#tratamientos\" class=\"hover:text-white transition\">Tratamientos</a>\n          <a href=\"#faq\" class=\"hover:text-white transition\">Frecuentes</a>\n        </div>\n      </div>\n\n      <!-- Nota de Cierre Discreta Requerida -->\n      <div class=\"bg-slate-900/45 rounded-2xl p-6 border border-slate-900 space-y-3\">\n        <span class=\"text-[10px] uppercase tracking-wider font-extrabold text-aurora-mint block\">Nota aclaratoria:</span>\n        <p class=\"text-xs text-slate-400 leading-relaxed font-medium\">\n          Esta es una demo ficticia desarrollada por <strong class=\"text-white\">DIGITEM-MX Salud</strong> para mostrar la estructura de una landing dental premium con SEO local, copy de confianza y conversión por WhatsApp. Si deseas conocer la arquitectura completa de nuestro servicio comercial, puedes visitar nuestra página sobre <a href=\"/salud/dentista\" class=\"text-aurora-mint underline font-bold hover:text-white transition\">Landing Pages para Dentistas</a> o volver al índice principal en <a href=\"/salud\" class=\"text-aurora-mint underline font-bold hover:text-white transition\">DIGITEM-MX Salud</a>.\n        </p>\n      </div>\n\n      <div class=\"flex flex-col sm:flex-row justify-between text-xs text-slate-600 gap-4\">\n        <p>© 2026 DIGITEM-MX. Todos los derechos reservados.</p>\n        <p>Desarrollado con fines de validación de UI/UX de alta conversión.</p>\n      </div>\n    </div>\n  </footer>\n\n  <!-- Inspector de SEO flotante (Developer Console Aesthetic) -->\n  <div id=\"seoInspector\" class=\"hidden fixed bottom-6 left-6 right-6 lg:left-auto lg:right-6 lg:w-[480px] bg-slate-950 border border-slate-800 rounded-[28px] shadow-2xl p-6 z-50 text-slate-200\">\n    <div class=\"flex justify-between items-center pb-4 mb-4 border-b border-slate-800\">\n      <div>\n        <span class=\"text-[9px] font-extrabold uppercase tracking-widest text-aurora-mint block\">DIGITEM-MX Salud</span>\n        <h4 class=\"font-extrabold text-white text-base\">Inspector de SEO Técnico (Salud Max)</h4>\n      </div>\n      <button onclick=\"toggleInspector()\" class=\"p-1.5 rounded-lg hover:bg-slate-900 text-slate-400 hover:text-white transition\">\n        ✕\n      </button>\n    </div>\n\n    <!-- Pestañas del Inspector -->\n    <div class=\"space-y-4\">\n      <p class=\"text-xs text-slate-400 font-medium\">Este panel le muestra a tu cliente dentista la infraestructura transparente que construimos para indexar y calificar en Google:</p>\n      \n      <!-- Campos SEO -->\n      <div class=\"space-y-3\">\n        <div class=\"bg-slate-900 rounded-xl p-3 text-xs space-y-1\">\n          <span class=\"font-bold text-slate-500 uppercase text-[9px] block\">Meta Title (Google Snippet):</span>\n          <p class=\"text-aurora-mint font-mono font-semibold\">Dentista en Ciudad de México | Clínica Dental Aurora</p>\n        </div>\n\n        <div class=\"bg-slate-900 rounded-xl p-3 text-xs space-y-1\">\n          <span class=\"font-bold text-slate-500 uppercase text-[9px] block\">Meta Description:</span>\n          <p class=\"text-aurora-mint font-mono leading-relaxed\">¿Buscas dentista en Ciudad de México? En Clínica Dental Aurora agenda tu limpieza, urgencia o valoración dental directo por WhatsApp. Atención confiable.</p>\n        </div>\n\n        <div class=\"bg-slate-900 rounded-xl p-3 text-xs space-y-1\">\n          <span class=\"font-bold text-slate-500 uppercase text-[9px] block\">Marcado Structured Data (Schema.org):</span>\n          <p class=\"text-slate-300 font-mono text-[10px] leading-relaxed max-h-24 overflow-y-auto bg-slate-950 p-2 rounded-lg\">\n            {<br>\n              &nbsp;&nbsp;\"@type\": \"Dentist\",<br>\n              &nbsp;&nbsp;\"name\": \"Clínica Dental Aurora\",<br>\n              &nbsp;&nbsp;\"geo\": \"CDMX (19.4326, -99.1332)\",<br>\n              &nbsp;&nbsp;\"openingHours\": \"Mon-Sat 09:00-19:00\"<br>\n            }\n          </p>\n        </div>\n      </div>\n\n      <div class=\"pt-2\">\n        <a href=\"https://wa.me/525522971545?text=Hola%20Digitem,%20vi%20la%20demo%20de%20odontolog%C3%ADa%20y%20quiero%20cotizar%20mi%20paquete%20Salud%20Max.\" \n           target=\"_blank\" \n           class=\"w-full bg-aurora-coral hover:bg-aurora-coral-dark text-white py-3.5 rounded-xl font-bold text-xs tracking-wider uppercase shadow-lg shadow-aurora-coral/20 transition flex items-center justify-center gap-2\">\n          ¡Me interesa este nivel de SEO para mi consultorio!\n        </a>\n      </div>\n    </div>\n  </div>\n\n  <!-- Toast de Notificación Ficticia (Simulador de Conversión de WhatsApp) -->\n  <div id=\"toast\" class=\"fixed bottom-6 right-6 bg-slate-950 border border-slate-800 text-white px-6 py-4 rounded-2xl shadow-2xl z-50 transform translate-y-24 opacity-0 transition-all duration-300 max-w-sm\">\n    <div class=\"flex items-start gap-3\">\n      <div class=\"text-xl\">🤖</div>\n      <div>\n        <strong class=\"font-extrabold text-sm block text-aurora-mint\">¡Así funciona la conversión!</strong>\n        <p class=\"text-xs text-slate-400 mt-1 leading-relaxed\">Esta acción redirigiría al paciente directamente a tu WhatsApp con el texto ya redactado y listo para enviar. Sin fricciones de registro.</p>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    // Configuración Inicial del Scheduler\n    let selectedDayText = 'Lunes';\n    \n    window.onload = function() {\n      updateMessagePreview();\n      updateFinalMessage();\n    }\n\n    // Lógica del programador de citas interactivo\n    function selectDay(element, day) {\n      // Remover estilo activo de todos los botones de día\n      const buttons = document.querySelectorAll('.day-btn');\n      buttons.forEach(btn => btn.classList.remove('bg-aurora-mint', 'text-white', 'border-aurora-mint'));\n      buttons.forEach(btn => btn.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200/80'));\n\n      // Aplicar activo al seleccionado (Paleta Aurora)\n      element.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200/80');\n      element.classList.add('bg-aurora-mint', 'text-white', 'border-aurora-mint');\n      \n      selectedDayText = day;\n      updateMessagePreview();\n    }\n\n    function updateMessagePreview() {\n      const service = document.getElementById('scheduleService').value;\n      const shiftElement = document.querySelector('input[name=\"shift\"]:checked');\n      const shift = shiftElement ? shiftElement.value : 'Turno Matutino (9:00 AM - 1:00 PM)';\n\n      // Estilizar visualmente la caja del turno seleccionado\n      const morningLabel = document.getElementById('labelShiftMorning');\n      const afternoonLabel = document.getElementById('labelShiftAfternoon');\n\n      if (shift.includes('Matutino')) {\n        morningLabel.classList.add('border-aurora-mint', 'bg-aurora-mint-light/20');\n        afternoonLabel.classList.remove('border-aurora-mint', 'bg-aurora-mint-light/20');\n      } else {\n        afternoonLabel.classList.add('border-aurora-mint', 'bg-aurora-mint-light/20');\n        morningLabel.classList.remove('border-aurora-mint', 'bg-aurora-mint-light/20');\n      }\n\n      // Generar preview del copy para WhatsApp\n      const previewText = `Hola Clínica Aurora, me gustaría solicitar una cita para: \"${service}\" el día ${selectedDayText} en el ${shift}.`;\n      document.getElementById('msgPreview').innerText = previewText;\n    }\n\n    // Ejecuta el Toast explicativo cuando interactúan con el envío de cita\n    function triggerMockBooking() {\n      const toast = document.getElementById('toast');\n      toast.classList.remove('translate-y-24', 'opacity-0');\n      \n      setTimeout(() => {\n        toast.classList.add('translate-y-24', 'opacity-0');\n      }, 5000);\n    }\n\n    // Formulario final de contacto con mensaje dinámico para WhatsApp\n    function getFinalMessage() {\n      const name = document.getElementById('finalName')?.value?.trim() || 'Hola Clínica Aurora';\n      const service = document.getElementById('finalService')?.value || 'Valoración Dental Inicial';\n      const timing = document.getElementById('finalTiming')?.value || 'esta semana';\n      const phone = document.getElementById('finalPhone')?.value?.trim();\n      const notes = document.getElementById('finalNotes')?.value?.trim();\n      let message = `${name}. Me gustaría agendar una cita para ${service} ${timing}.`;\n      if (phone) message += ` Mi teléfono es ${phone}.`;\n      if (notes) message += ` Comentario: ${notes}.`;\n      return message;\n    }\n\n    function updateFinalMessage() {\n      const preview = document.getElementById('finalMsgPreview');\n      if (preview) preview.innerText = getFinalMessage();\n    }\n\n    function sendFinalWhatsApp() {\n      const message = encodeURIComponent(getFinalMessage());\n      window.open(`https://wa.me/525522971545?text=${message}`, '_blank');\n    }\n\n    // Toggle para los acordeones FAQ (Animación de suavizado nativa)\n    function toggleAccordion(id) {\n      const content = document.getElementById(`${id}-content`);\n      const icon = document.getElementById(`${id}-icon`);\n      \n      if (content.style.maxHeight && content.style.maxHeight !== '0px') {\n        content.style.maxHeight = '0px';\n        icon.innerText = '+';\n        icon.classList.remove('rotate-45');\n      } else {\n        content.style.maxHeight = content.scrollHeight + 'px';\n        icon.innerText = '✕';\n        icon.classList.add('rotate-45');\n      }\n    }\n\n    // Toggle Inspector SEO en vivo\n    function toggleInspector() {\n      const inspector = document.getElementById('seoInspector');\n      inspector.classList.toggle('hidden');\n    }\n\n    // Toggle Menú Móvil\n    function toggleMobileMenu() {\n      const menu = document.getElementById('mobileMenu');\n      menu.classList.toggle('hidden');\n    }\n  </script>\n</body>\n</html>";
