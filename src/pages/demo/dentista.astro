const fullPage = "<!DOCTYPE html>\n<html lang=\"es\" class=\"scroll-smooth\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Dentista en Ciudad de México | Clínica Dental Aurora</title>\n  <meta name=\"description\" content=\"¿Buscas dentista en Ciudad de México? En Clínica Dental Aurora agenda tu limpieza, urgencia o valoración dental directo por WhatsApp. Atención confiable.\">\n  <link rel=\"canonical\" href=\"https://digitem-mx.com/demo/dentista\" />\n\n  <!-- Open Graph / Meta-tags de Redes Sociales -->\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:title\" content=\"Dentista en Ciudad de México | Clínica Dental Aurora\" />\n  <meta property=\"og:description\" content=\"Atención odontológica ética y profesional. Limpieza, ortodoncia y urgencias con agendamiento inmediato por WhatsApp.\" />\n  <meta property=\"og:image\" content=\"https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&q=80&w=1200\" />\n  <meta property=\"og:url\" content=\"https://digitem-mx.com/demo/dentista\" />\n\n  <!-- Google Fonts & Tailwind CSS CDN -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  \n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          fontFamily: {\n            sans: ['\"Plus Jakarta Sans\"', 'sans-serif'],\n          },\n          colors: {\n            aurora: {\n              // Paleta inspirada en las luces nórdicas (Efecto ansiolítico, relajante y sumamente sofisticado)\n              mint: '#0d9488',       // Verde menta/teal profundo (Higiene, salud, naturaleza)\n              sky: '#06b6d4',        // Azul cielo brillante (Tecnología, frescura)\n              purple: '#6366f1',     // Violeta crepuscular (Premium, calma profunda)\n              dark: '#0f172a',       // Slate/Azul espacial oscuro (Contraste premium)\n              light: '#f0fdfa',      // Fondo ultra-limpio menta suave\n              coral: '#f43f5e',      // Coral rosado (Acción viva, calidez, contraste orgánico)\n              'coral-dark': '#be123c',\n              'mint-light': '#ccfbf1',\n              'purple-light': '#e0e7ff',\n              gray: '#f8fafc'\n            }\n          },\n          boxShadow: {\n            'glow-mint': '0 0 20px rgba(13, 148, 136, 0.15)',\n            'glow-coral': '0 0 25px rgba(244, 63, 94, 0.25)'\n          }\n        }\n      }\n    }\n  </script>\n\n  <!-- Schema JSON-LD Estructurado -->\n  <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Dentist\",\n      \"name\": \"Clínica Dental Aurora - Demo Ficticia\",\n      \"image\": \"https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&q=80&w=800\",\n      \"telephone\": \"+525522971545\",\n      \"url\": \"https://digitem-mx.com/demo/dentista\",\n      \"priceRange\": \"$$\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Ciudad de México\",\n        \"addressRegion\": \"CDMX\",\n        \"addressCountry\": \"MX\"\n      },\n      \"geo\": {\n        \"@type\": \"GeoCoordinates\",\n        \"latitude\": \"19.4326\",\n        \"longitude\": \"-99.1332\"\n      },\n      \"openingHoursSpecification\": {\n        \"@type\": \"OpeningHoursSpecification\",\n        \"dayOfWeek\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\"],\n        \"opens\": \"09:00\",\n        \"closes\": \"19:00\"\n      }\n    }\n  </script>\n\n  <!-- Schema FAQ Page para Snippets Enriquecidos -->\n  <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"¿Cuándo debo agendar una valoración dental?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Se recomienda acudir a una valoración general al menos una vez al año, o de inmediato si experimentas sensibilidad, dolor o cambios en tus encías. Una revisión oportuna nos permite detectar problemas pequeños antes de que requieran intervenciones complejas.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"¿Puedo escribir por WhatsApp para una urgencia dental?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Sí, nuestro canal está disponible para atender tus mensajes y coordinar un espacio prioritario en nuestra agenda en caso de dolor severo o urgencias dentales en Ciudad de México.\"\n          }\n        }\n      ]\n    }\n  </script>\n\n  <style>\n    html{scroll-behavior:smooth} body{overflow-x:hidden}\n    .aurora-soft-focus{filter:saturate(.92) contrast(.98)}\n    @media(max-width:640px){.hero-title-mobile{font-size:clamp(2.15rem,10.8vw,3.45rem);line-height:1.03}}\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 font-sans antialiased selection:bg-aurora-mint selection:text-white\">\n\n  <!-- Top Banner Informativo de Demo -->\n  <div class=\"bg-gradient-to-r from-aurora-dark via-slate-900 to-aurora-purple text-white text-xs py-2 px-4 flex justify-between items-center z-50 sticky top-0 border-b border-white/10\">\n    <div class=\"flex items-center gap-2\">\n      <span class=\"inline-block w-2.5 h-2.5 rounded-full bg-aurora-coral animate-pulse shadow-glow-coral\"></span>\n      <span class=\"font-medium tracking-wide\">DEMO PREMIUM · CLÍNICA DENTAL AURORA</span>\n    </div>\n    <div class=\"flex items-center gap-4\">\n      <button onclick=\"toggleInspector()\" class=\"bg-white/10 hover:bg-white/20 px-3 py-1 rounded-full text-[11px] font-semibold tracking-wide transition flex items-center gap-1\">\n        <span>👁️</span> <span class=\"hidden sm:inline\">Ver SEO Local</span><span class=\"sm:hidden\">SEO</span>\n      </button>\n    </div>\n  </div>\n\n  <!-- Header / Navigation -->\n  <header class=\"bg-white/80 backdrop-blur-md shadow-sm sticky top-[33px] z-40 transition-all duration-300 border-b border-slate-100\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex justify-between items-center\">\n      <!-- Logo Clínica -->\n      <a href=\"#hero\" class=\"flex items-center gap-3 group\">\n        <div class=\"w-11 h-11 bg-gradient-to-tr from-aurora-mint to-aurora-purple rounded-xl flex items-center justify-center shadow-lg shadow-aurora-mint/10 transition group-hover:scale-105\">\n          <svg class=\"w-6 h-6 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1\" />\n          </svg>\n        </div>\n        <div>\n          <span class=\"font-extrabold text-xl text-aurora-dark tracking-tight block\">Clínica Aurora</span>\n          <span class=\"text-[10px] text-aurora-mint tracking-widest font-extrabold uppercase block -mt-1\">Salud Dental CDMX</span>\n        </div>\n      </a>\n\n      <!-- Menu Desktop -->\n      <nav class=\"hidden md:flex items-center gap-8 text-[13px] tracking-wide uppercase font-bold text-slate-500\">\n        <a href=\"#confianza\" class=\"hover:text-aurora-mint transition-colors\">Confianza</a>\n        <a href=\"#tratamientos\" class=\"hover:text-aurora-mint transition-colors\">Tratamientos</a>\n        <a href=\"#ortodoncia\" class=\"hover:text-aurora-mint transition-colors\">Estética</a>\n        <a href=\"#proceso\" class=\"hover:text-aurora-mint transition-colors\">¿Cómo funciona?</a>\n        <a href=\"#faq\" class=\"hover:text-aurora-mint transition-colors\">Preguntas</a>\n      </nav>\n\n      <!-- Botón de Acción -->\n      <div class=\"hidden sm:flex items-center gap-4\">\n        <a href=\"https://wa.me/525522971545?text=Hola%20Cl%C3%ADnica%20Aurora,%20me%20gustar%C3%ADa%20agendar%20una%20valoraci%C3%B3n\" \n           target=\"_blank\" \n           class=\"bg-aurora-coral hover:bg-aurora-coral-dark text-white px-5 py-3 rounded-xl font-bold text-xs tracking-wider uppercase shadow-lg shadow-aurora-coral/20 hover:shadow-xl hover:shadow-aurora-coral/30 transition-all duration-300 flex items-center gap-2 transform hover:-translate-y-0.5\">\n          <svg class=\"w-4 h-4 fill-white\" viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.73-1.45L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.968C16.628 1.97 14.155.945 11.53.945 6.096.945 1.673 5.313 1.67 10.742c-.001 1.69.444 3.34 1.288 4.793l-.999 3.648 3.733-.967-.044.024-.002.016zm12.115-4.504c-.312-.156-1.847-.91-2.128-1.012-.282-.101-.487-.152-.692.157-.205.308-.795 1.011-.974 1.213-.18.203-.36.228-.672.072-.312-.156-1.318-.486-2.51-1.549-.928-.828-1.555-1.85-1.737-2.162-.18-.312-.019-.481.137-.636.141-.14.312-.364.468-.546.156-.182.208-.312.312-.52.104-.208.052-.39-.026-.546-.078-.156-.692-1.666-.949-2.285-.25-.601-.525-.519-.718-.529l-.615-.01c-.205 0-.538.078-.82.384-.282.308-1.077 1.053-1.077 2.568 0 1.515 1.102 2.981 1.256 3.184.154.203 2.169 3.313 5.253 4.643.734.317 1.307.507 1.753.649.738.234 1.41.201 1.942.122.593-.088 1.847-.755 2.103-1.447.256-.692.256-1.289.18-1.417-.078-.129-.283-.207-.595-.363z\"/></svg>\n          Agendar Cita\n        </a>\n      </div>\n\n      <!-- Mobile Menu Button -->\n      <button onclick=\"toggleMobileMenu()\" class=\"md:hidden p-2.5 rounded-xl text-slate-600 hover:bg-slate-100 transition\">\n        <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16m-7 6h7\" />\n        </svg>\n      </button>\n    </div>\n\n    <!-- Mobile Navigation Drawer -->\n    <div id=\"mobileMenu\" class=\"hidden md:hidden border-t border-slate-100 bg-white/95 backdrop-blur-md px-4 py-6 space-y-4 shadow-xl\">\n      <a href=\"#confianza\" onclick=\"toggleMobileMenu()\" class=\"block font-bold text-slate-700 hover:text-aurora-mint tracking-wide\">Confianza</a>\n      <a href=\"#tratamientos\" onclick=\"toggleMobileMenu()\" class=\"block font-bold text-slate-700 hover:text-aurora-mint tracking-wide\">Tratamientos</a>\n      <a href=\"#ortodoncia\" onclick=\"toggleMobileMenu()\" class=\"block font-bold text-slate-700 hover:text-aurora-mint tracking-wide\">Estética</a>\n      <a href=\"#proceso\" onclick=\"toggleMobileMenu()\" class=\"block font-bold text-slate-700 hover:text-aurora-mint tracking-wide\">¿Cómo funciona?</a>\n      <a href=\"#faq\" onclick=\"toggleMobileMenu()\" class=\"block font-bold text-slate-700 hover:text-aurora-mint tracking-wide\">Preguntas Frecuentes</a>\n      <a href=\"https://wa.me/525522971545?text=Hola%20Cl%C3%ADnica%20Aurora,%20me%20gustar%C3%ADa%20agendar%20una%20valoraci%C3%B3n\" \n         target=\"_blank\" \n         class=\"block bg-aurora-coral text-white text-center py-3 rounded-xl font-bold shadow-md tracking-wider uppercase\">\n        Agendar por WhatsApp\n      </a>\n    </div>\n  </header>\n\n  <!-- Hero Section -->\n  <section id=\"hero\" class=\"relative py-16 lg:py-24 overflow-hidden bg-gradient-to-b from-aurora-light via-slate-50 to-white\">\n    <!-- Efectos luminosos de fondo de Aurora Boreal (UX para calmar la ansiedad) -->\n    <div class=\"absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-gradient-to-tr from-aurora-mint/20 to-aurora-sky/10 blur-[120px] pointer-events-none\"></div>\n    <div class=\"absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-gradient-to-br from-aurora-purple/15 to-aurora-mint/10 blur-[120px] pointer-events-none\"></div>\n\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-12 gap-12 items-center relative z-10\">\n      \n      <!-- Copy de Impacto -->\n      <div class=\"lg:col-span-7 space-y-7 lg:pr-8\">\n        <div class=\"inline-flex items-center gap-2 bg-gradient-to-r from-aurora-mint-light to-aurora-purple-light text-aurora-mint px-4 py-2 rounded-full text-xs font-extrabold tracking-wider uppercase shadow-sm\">\n          <span class=\"w-2 h-2 rounded-full bg-aurora-mint animate-ping\"></span>\n          CLÍNICA DENTAL EN CIUDAD DE MÉXICO\n        </div>\n        <h1 class=\"hero-title-mobile text-4xl sm:text-5xl lg:text-6xl font-extrabold text-aurora-dark tracking-tight leading-[1.1]\">\n          Dentista en Ciudad de México para <span class=\"bg-gradient-to-r from-aurora-mint to-aurora-sky bg-clip-text text-transparent\">valoración</span>, <span class=\"bg-gradient-to-r from-aurora-mint to-aurora-sky bg-clip-text text-transparent\">limpieza dental</span> y <span class=\"bg-gradient-to-r from-aurora-sky to-aurora-purple bg-clip-text text-transparent\">urgencias</span>.\n        </h1>\n        <p class=\"text-[17px] text-slate-600 leading-relaxed max-w-xl font-medium\">\n          En Clínica Dental Aurora te ayudamos a recibir una atención clara, segura y profesional. Nos enfocamos en cuidar de tu sonrisa en un espacio de absoluta tranquilidad, facilitando tu comunicación directa por WhatsApp.\n        </p>\n\n        <!-- CTAs -->\n        <div class=\"flex flex-col sm:flex-row gap-4 pt-2\">\n          <a href=\"#scheduler\" class=\"bg-aurora-coral hover:bg-aurora-coral-dark text-white px-8 py-4.5 rounded-2xl font-extrabold text-center shadow-lg shadow-aurora-coral/20 hover:shadow-xl hover:shadow-aurora-coral/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-3\">\n            <span>Agendar valoración por WhatsApp</span>\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\" /></svg>\n          </a>\n          <a href=\"#tratamientos\" class=\"border-2 border-slate-200 hover:border-aurora-mint hover:text-aurora-mint text-slate-600 bg-white px-8 py-4.5 rounded-2xl font-extrabold text-center transition flex items-center justify-center gap-2 shadow-sm\">\n            Ver tratamientos\n          </a>\n        </div>\n\n        <p class=\"text-xs text-slate-400 font-medium\">\n          Respuesta rápida en horario de atención. <span class=\"font-bold text-aurora-mint\">Esta es una demo ficticia creada por DIGITEM-MX Salud.</span>\n        </p>\n\n        <!-- Trust Badges -->\n        <div class=\"pt-6 border-t border-slate-100 grid grid-cols-3 gap-4\">\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-10 h-10 rounded-xl bg-aurora-mint-light/50 text-aurora-mint flex items-center justify-center text-lg shadow-glow-mint\">\n              🔍\n            </div>\n            <div>\n              <p class=\"text-[10px] text-slate-400 font-bold uppercase tracking-wide\">SEO Local</p>\n              <strong class=\"text-xs text-slate-800 block leading-tight font-extrabold\">Listo para Google</strong>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-10 h-10 rounded-xl bg-aurora-purple-light/50 text-aurora-purple flex items-center justify-center text-lg\">\n              💬\n            </div>\n            <div>\n              <p class=\"text-[10px] text-slate-400 font-bold uppercase tracking-wide\">WhatsApp</p>\n              <strong class=\"text-xs text-slate-800 block leading-tight font-extrabold\">Canal Directo</strong>\n            </div>\n          </div>\n          <div class=\"flex items-center gap-3\">\n            <div class=\"w-10 h-10 rounded-xl bg-rose-50 text-aurora-coral flex items-center justify-center text-lg\">\n              🌟\n            </div>\n            <div>\n              <p class=\"text-[10px] text-slate-400 font-bold uppercase tracking-wide\">Confianza</p>\n              <strong class=\"text-xs text-slate-800 block leading-tight font-extrabold\">Cero Fricción</strong>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Imagen Destacada & Widget Interactivo de Agendamiento -->\n      <div id=\"scheduler\" class=\"lg:col-span-5 relative\">\n        <div class=\"absolute -inset-4 bg-gradient-to-tr from-aurora-mint/15 to-aurora-purple/15 rounded-[36px] blur-2xl z-0\"></div>\n        \n        <!-- Tarjeta del Programador de Citas (Glassmorphism sutil) -->\n        <div class=\"relative bg-white/90 backdrop-blur-md rounded-[32px] shadow-xl border border-slate-100 p-6 sm:p-8 z-10 transition-all hover:shadow-2xl\">\n          <div class=\"flex items-center justify-between pb-4 mb-5 border-b border-slate-100\">\n            <div>\n              <span class=\"text-[10px] uppercase font-black tracking-widest text-aurora-coral\">Agenda digital</span>\n              <h3 class=\"font-extrabold text-xl text-aurora-dark leading-none mt-1\">Coordina tu cita</h3>\n            </div>\n            <div class=\"w-3 h-3 rounded-full bg-emerald-500 animate-pulse shadow-md shadow-emerald-500/50\"></div>\n          </div>\n\n          <!-- Formulario Interactivo -->\n          <div class=\"space-y-5\">\n            <!-- Selección de Servicio -->\n            <div>\n              <label class=\"block text-[11px] font-extrabold text-slate-400 uppercase tracking-wider mb-2\">1. Tratamiento Requerido</label>\n              <select id=\"scheduleService\" onchange=\"updateMessagePreview()\" class=\"w-full bg-slate-50 border border-slate-200/80 rounded-xl px-4 py-3 text-[13px] font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-aurora-mint transition\">\n                <option value=\"Valoración Dental Inicial\">Valoración Dental Inicial</option>\n                <option value=\"Limpieza Dental Preventiva\">Limpieza Dental Preventiva</option>\n                <option value=\"Urgencia Dental CDMX\">Urgencia Dental (Atención Rápida)</option>\n                <option value=\"Estudio de Ortodoncia / Brackets\">Ortodoncia y Brackets</option>\n                <option value=\"Alineadores Invisibles\">Alineadores Invisibles</option>\n                <option value=\"Diseño de Sonrisa Estético\">Diseño de Sonrisa Estético</option>\n                <option value=\"Odontología Familiar / General\">Odontología Familiar</option>\n              </select>\n            </div>\n\n            <!-- Selección de Día -->\n            <div>\n              <label class=\"block text-[11px] font-extrabold text-slate-400 uppercase tracking-wider mb-2\">2. Día Sugerido</label>\n              <div class=\"grid grid-cols-4 gap-2\">\n                <button type=\"button\" onclick=\"selectDay(this, 'Lunes')\" class=\"day-btn bg-slate-50 hover:bg-slate-100 border border-slate-200/80 py-2.5 rounded-xl text-xs font-bold text-slate-700 transition active-day\">Lunes</button>\n                <button type=\"button\" onclick=\"selectDay(this, 'Martes')\" class=\"day-btn bg-slate-50 hover:bg-slate-100 border border-slate-200/80 py-2.5 rounded-xl text-xs font-bold text-slate-700 transition\">Martes</button>\n                <button type=\"button\" onclick=\"selectDay(this, 'Miércoles')\" class=\"day-btn bg-slate-50 hover:bg-slate-100 border border-slate-200/80 py-2.5 rounded-xl text-xs font-bold text-slate-700 transition\">Miérc.</button>\n                <button type=\"button\" onclick=\"selectDay(this, 'Jueves')\" class=\"day-btn bg-slate-50 hover:bg-slate-100 border border-slate-200/80 py-2.5 rounded-xl text-xs font-bold text-slate-700 transition\">Jueves</button>\n              </div>\n            </div>\n\n            <!-- Horario del Turno -->\n            <div>\n              <label class=\"block text-[11px] font-extrabold text-slate-400 uppercase tracking-wider mb-2\">3. Horario Preferido</label>\n              <div class=\"grid grid-cols-2 gap-3\">\n                <label class=\"relative flex items-center justify-center bg-slate-50 border border-slate-200/80 rounded-xl py-3 px-4 cursor-pointer hover:bg-slate-100 transition shadow-sm\" id=\"labelShiftMorning\">\n                  <input type=\"radio\" name=\"shift\" value=\"Turno Matutino (9:00 AM - 1:00 PM)\" checked onchange=\"updateMessagePreview()\" class=\"absolute opacity-0\">\n                  <span class=\"text-xs font-bold text-slate-700\">Mañana (9:00 - 13:00)</span>\n                </label>\n                <label class=\"relative flex items-center justify-center bg-slate-50 border border-slate-200/80 rounded-xl py-3 px-4 cursor-pointer hover:bg-slate-100 transition shadow-sm\" id=\"labelShiftAfternoon\">\n                  <input type=\"radio\" name=\"shift\" value=\"Turno Vespertino (2:00 PM - 7:00 PM)\" onchange=\"updateMessagePreview()\" class=\"absolute opacity-0\">\n                  <span class=\"text-xs font-bold text-slate-700\">Tarde (14:00 - 19:00)</span>\n                </label>\n              </div>\n            </div>\n\n            <!-- Caja de Mensaje Generado (Efecto \"Wow\" de conversión) -->\n            <div class=\"bg-gradient-to-r from-aurora-mint-light/60 to-aurora-purple-light/40 border border-aurora-mint/10 rounded-2xl p-4 text-xs space-y-1\">\n              <span class=\"font-extrabold uppercase text-[10px] tracking-wider text-aurora-mint block\">Mensaje prellenado para WhatsApp:</span>\n              <p id=\"msgPreview\" class=\"italic text-slate-600 leading-relaxed font-semibold\">Cargando formato de mensaje...</p>\n  