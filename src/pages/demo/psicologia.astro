---
const whatsappBase = 'https://wa.me/525522971545';
const whatsappText = encodeURIComponent('Hola, estoy revisando la demo de psicología humanista FRAB de DIGITEM-MX Salud y me gustaría conocer cómo funcionaría una landing así para mi consulta.');
const whatsappHref = `${whatsappBase}?text=${whatsappText}`;

const faqItems = [
  {
    question: '¿Cómo saber si necesito iniciar terapia con FRAB Psicóloga?',
    answer:
      'No necesitas estar atravesando una crisis extrema para buscar apoyo. Si experimentas malestar constante, cambios difíciles, deseo de conocerte mejor o necesitas un espacio neutral para comprender tus emociones, la psicoterapia humanista puede ser un recurso de acompañamiento y crecimiento.',
  },
  {
    question: '¿Qué pasa exactamente en la primera sesión de terapia?',
    answer:
      'La primera sesión es un espacio de encuentro. Conversamos con tranquilidad sobre lo que te trae aquí, resolvemos dudas de logística y exploramos tus necesidades sin presión. Tú decides cuánto compartir y a qué ritmo avanzar.',
  },
  {
    question: '¿La terapia online ofrece la misma calidez que la presencial?',
    answer:
      'Sí. El enfoque humanista se sostiene en la calidad del encuentro, la escucha y el vínculo. Con una conexión estable y un espacio privado, la terapia online puede conservar cercanía, confidencialidad y continuidad.',
  },
  {
    question: '¿Cuánto dura cada sesión y con qué frecuencia debo asistir?',
    answer:
      'Las sesiones individuales suelen durar entre 50 y 60 minutos. La frecuencia se acuerda de forma conjunta, tomando en cuenta tus tiempos, necesidades y el tipo de proceso que deseas iniciar.',
  },
  {
    question: '¿Qué temas puedo trabajar en este espacio?',
    answer:
      'Podemos explorar ansiedad, estrés, autoestima, autocrítica, duelo, transiciones de vida, relaciones interpersonales y procesos de autoconocimiento. Si tu necesidad requiere otra especialidad, se orienta de forma ética.',
  },
  {
    question: '¿Cómo puedo agendar mi primera sesión?',
    answer:
      'Puedes escribir directamente por WhatsApp desde esta página. El primer mensaje sirve para resolver dudas, revisar disponibilidad y coordinar una primera sesión presencial u online.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Psychologist',
      '@id': 'https://digitem-mx.com/demo/psicologia/#psychologist',
      name: 'FRAB Psicóloga - Psicoterapia Humanista (Demo Ficticia)',
      url: 'https://digitem-mx.com/demo/psicologia',
      telephone: '+525522971545',
      priceRange: '$$',
      image: 'https://images.unsplash.com/photo-1493836512294-502baa1986e2?auto=format&fit=crop&q=80&w=1200',
      description:
        'Psicóloga humanista en Ciudad de México que ofrece psicoterapia individual, presencial y online centrada en la persona para ansiedad, autoestima, duelo y crecimiento personal.',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Ciudad de México',
        addressRegion: 'CDMX',
        addressCountry: 'MX',
      },
      knowsAbout: [
        'Psicoterapia humanista',
        'Ansiedad y estrés',
        'Autoestima y autoconocimiento',
        'Acompañamiento en duelo',
        'Terapia online',
      ],
      areaServed: 'Ciudad de México',
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://digitem-mx.com/demo/psicologia/#faq',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
    {
      '@type': 'Service',
      '@id': 'https://digitem-mx.com/demo/psicologia/#service',
      name: 'Psicoterapia humanista individual presencial y online',
      provider: {
        '@id': 'https://digitem-mx.com/demo/psicologia/#psychologist',
      },
      areaServed: 'Ciudad de México',
      serviceType: 'Psicoterapia humanista',
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Psicóloga Humanista en Ciudad de México | FRAB Psicóloga</title>
    <meta
      name="description"
      content="¿Buscas un espacio seguro de terapia? Conoce el acompañamiento humanista de FRAB Psicóloga en CDMX y online. Explora tu presente libre de juicios."
    />
    <link rel="canonical" href="https://digitem-mx.com/demo/psicologia" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Terapia Psicológica Humanista en Ciudad de México | FRAB" />
    <meta
      property="og:description"
      content="Un espacio de encuentro humano, aceptación y confidencialidad. Terapia presencial en CDMX y acompañamiento emocional online."
    />
    <meta
      property="og:image"
      content="https://images.unsplash.com/photo-1493836512294-502baa1986e2?auto=format&fit=crop&q=80&w=1200"
    />
    <meta property="og:url" content="https://digitem-mx.com/demo/psicologia" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <style>
      :root {
        --sage: #8aa899;
        --sage-deep: #385949;
        --sage-dark: #1f342c;
        --sage-soft: #e9f0ea;
        --sand: #f7f0e5;
        --paper: #fffdf8;
        --clay: #c79b77;
        --rose: #d7aaa2;
        --ink: #24332d;
        --muted: #6e7b73;
        --line: rgba(36, 51, 45, 0.12);
        --shadow: 0 24px 80px rgba(31, 52, 44, 0.14);
        --radius: 30px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--ink);
        background: var(--paper);
        line-height: 1.55;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button,
      input,
      select,
      textarea {
        font: inherit;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .wrap {
        width: min(1180px, calc(100% - 42px));
        margin: 0 auto;
      }

      .demo-strip {
        position: sticky;
        top: 0;
        z-index: 50;
        background: linear-gradient(90deg, #142720, #39594b 48%, #8aa899);
        color: white;
        border-bottom: 1px solid rgba(255, 255, 255, 0.18);
      }

      .demo-strip__inner {
        min-height: 46px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .demo-strip__label {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .pulse-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #f2b39d;
        box-shadow: 0 0 0 rgba(242, 179, 157, 0.55);
        animation: pulse 2.6s infinite;
      }

      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(242, 179, 157, 0.55); }
        70% { box-shadow: 0 0 0 14px rgba(242, 179, 157, 0); }
        100% { box-shadow: 0 0 0 0 rgba(242, 179, 157, 0); }
      }

      .seo-open {
        border: 1px solid rgba(255, 255, 255, 0.45);
        background: rgba(255, 255, 255, 0.12);
        color: white;
        border-radius: 999px;
        padding: 9px 14px;
        cursor: pointer;
        transition: transform 0.45s ease, background 0.45s ease;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .seo-open:hover {
        transform: translateY(-2px);
        background: rgba(255, 255, 255, 0.2);
      }

      .nav {
        position: sticky;
        top: 46px;
        z-index: 40;
        background: rgba(255, 253, 248, 0.82);
        backdrop-filter: blur(18px);
        border-bottom: 1px solid rgba(36, 51, 45, 0.08);
      }

      .nav__inner {
        height: 78px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .brand__mark {
        width: 42px;
        height: 42px;
        border-radius: 16px;
        background: conic-gradient(from 130deg, var(--sage), #bfd0c1, var(--clay), var(--sage-deep), var(--sage));
        position: relative;
        box-shadow: 0 16px 34px rgba(56, 89, 73, 0.18);
      }

      .brand__mark::after {
        content: '';
        position: absolute;
        inset: 10px;
        border-radius: 11px;
        background: var(--paper);
      }

      .brand strong {
        display: block;
        font-size: 1rem;
        letter-spacing: -0.02em;
      }

      .brand span {
        display: block;
        margin-top: -2px;
        color: var(--sage-deep);
        font-size: 0.65rem;
        font-weight: 850;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .nav__links {
        display: flex;
        align-items: center;
        gap: 26px;
        color: var(--muted);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .nav__cta,
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 0;
        cursor: pointer;
        border-radius: 999px;
        padding: 14px 20px;
        font-size: 0.82rem;
        font-weight: 850;
        transition: transform 0.5s ease, box-shadow 0.5s ease, background 0.5s ease;
      }

      .nav__cta,
      .btn--primary {
        background: var(--sage-deep);
        color: white;
        box-shadow: 0 14px 35px rgba(56, 89, 73, 0.22);
      }

      .btn--primary:hover,
      .nav__cta:hover {
        transform: translateY(-3px);
        box-shadow: 0 20px 48px rgba(56, 89, 73, 0.27);
      }

      .btn--secondary {
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid var(--line);
        color: var(--sage-dark);
      }

      .btn--secondary:hover {
        transform: translateY(-3px);
        background: white;
      }

      .hero {
        min-height: calc(100svh - 126px);
        display: grid;
        align-items: center;
        position: relative;
        overflow: hidden;
        background:
          linear-gradient(90deg, rgba(255, 253, 248, 0.96), rgba(255, 253, 248, 0.84) 44%, rgba(255, 253, 248, 0.05)),
          url('https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&q=85&w=1800') center right / cover;
      }

      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 25% 20%, rgba(138, 168, 153, 0.22), transparent 38%), radial-gradient(circle at 72% 75%, rgba(199, 155, 119, 0.18), transparent 36%);
        pointer-events: none;
      }

      .hero__content {
        position: relative;
        max-width: 690px;
        padding: 56px 0 58px;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 13px;
        border-radius: 999px;
        background: rgba(233, 240, 234, 0.9);
        color: var(--sage-deep);
        border: 1px solid rgba(56, 89, 73, 0.12);
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--clay);
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        margin: 18px 0 14px;
        font-size: clamp(2.45rem, 5.7vw, 5.35rem);
        line-height: 0.98;
        letter-spacing: -0.07em;
        max-width: 760px;
      }

      .hero__seo {
        font-size: clamp(1.05rem, 1.5vw, 1.24rem);
        color: var(--sage-deep);
        font-weight: 800;
        margin-bottom: 16px;
      }

      .lead {
        color: var(--muted);
        font-size: 1.06rem;
        max-width: 610px;
      }

      .hero__actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 24px;
      }

      .microcopy {
        margin-top: 18px;
        color: #7e8a83;
        font-size: 0.83rem;
      }

      .hero__note {
        margin-top: 28px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        max-width: 640px;
      }

      .soft-pill {
        padding: 14px;
        border: 1px solid var(--line);
        background: rgba(255, 253, 248, 0.68);
        backdrop-filter: blur(14px);
        border-radius: 20px;
        box-shadow: 0 14px 38px rgba(31, 52, 44, 0.08);
        font-size: 0.8rem;
        font-weight: 780;
        color: var(--sage-dark);
      }

      .section {
        padding: clamp(70px, 9vw, 118px) 0;
        position: relative;
      }

      .section--soft {
        background: linear-gradient(180deg, var(--paper), var(--sand));
      }

      .section__head {
        max-width: 760px;
        margin-bottom: 44px;
      }

      .section__head.center {
        text-align: center;
        margin-left: auto;
        margin-right: auto;
      }

      h2 {
        font-size: clamp(1.9rem, 4.2vw, 4.25rem);
        line-height: 1;
        letter-spacing: -0.055em;
        margin-bottom: 18px;
      }

      h3 {
        line-height: 1.1;
        letter-spacing: -0.03em;
      }

      .journey {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .journey-card {
        min-height: 340px;
        border-radius: var(--radius);
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(56, 89, 73, 0.12);
        padding: 28px;
        box-shadow: 0 18px 55px rgba(31, 52, 44, 0.08);
        transition: transform 0.85s cubic-bezier(.2,.8,.2,1), box-shadow 0.85s ease;
      }

      .journey-card:hover {
        transform: translateY(-10px) rotateX(2deg);
        box-shadow: 0 28px 80px rgba(31, 52, 44, 0.14);
      }

      .number {
        display: inline-flex;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--sage-dark);
        color: white;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        margin-bottom: 28px;
      }

      .kicker {
        color: var(--clay);
        text-transform: uppercase;
        font-size: 0.74rem;
        font-weight: 920;
        letter-spacing: 0.13em;
        margin-bottom: 10px;
      }

      .quote {
        font-size: 1.35rem;
        color: var(--sage-dark);
        font-weight: 850;
        letter-spacing: -0.04em;
        margin-bottom: 16px;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 24px;
      }

      .tag {
        border: 1px solid rgba(56, 89, 73, 0.14);
        background: var(--sage-soft);
        color: var(--sage-deep);
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 0.73rem;
        font-weight: 850;
      }

      .human-image {
        min-height: 100svh;
        position: relative;
        display: grid;
        align-items: end;
        overflow: hidden;
        color: white;
        background:
          linear-gradient(0deg, rgba(17, 31, 25, 0.74), rgba(17, 31, 25, 0.25) 55%, rgba(17, 31, 25, 0.12)),
          url('https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&q=85&w=1900') center / cover;
      }

      .human-image__content {
        padding: 0 0 90px;
        position: relative;
        z-index: 2;
        max-width: 860px;
      }

      .human-image h2 {
        font-size: clamp(2.7rem, 6vw, 6rem);
        color: white;
        max-width: 840px;
      }

      .human-image p {
        max-width: 640px;
        color: rgba(255, 255, 255, 0.82);
        font-size: 1.14rem;
      }

      .floating-searches {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }

      .float-pill {
        position: absolute;
        border-radius: 999px;
        padding: 12px 17px;
        background: rgba(255, 253, 248, 0.86);
        color: var(--sage-dark);
        box-shadow: 0 18px 48px rgba(0, 0, 0, 0.14);
        backdrop-filter: blur(14px);
        font-size: 0.84rem;
        font-weight: 830;
        animation: floaty 6s ease-in-out infinite;
      }

      .float-pill:nth-child(1) { top: 16%; left: 8%; }
      .float-pill:nth-child(2) { top: 22%; right: 12%; animation-delay: .9s; }
      .float-pill:nth-child(3) { top: 42%; right: 7%; animation-delay: 1.6s; }
      .float-pill:nth-child(4) { bottom: 28%; left: 10%; animation-delay: .4s; }
      .float-pill:nth-child(5) { bottom: 17%; right: 18%; animation-delay: 2.1s; }
      .float-pill:nth-child(6) { top: 58%; left: 19%; animation-delay: 1.2s; }

      @keyframes floaty {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-14px); }
      }

      .services {
        display: grid;
        gap: 34px;
      }

      .service-row {
        display: grid;
        grid-template-columns: 0.92fr 1.08fr;
        gap: 40px;
        align-items: center;
        padding: 26px;
        border: 1px solid var(--line);
        border-radius: 42px;
        background: rgba(255, 255, 255, 0.68);
        box-shadow: 0 18px 52px rgba(31, 52, 44, 0.06);
      }

      .service-row:nth-child(even) {
        grid-template-columns: 1.08fr 0.92fr;
      }

      .service-row:nth-child(even) .service-image {
        order: 2;
      }

      .service-image {
        min-height: 330px;
        border-radius: 32px;
        overflow: hidden;
        background: var(--sage-soft);
      }

      .service-image img {
        width: 100%;
        height: 100%;
        min-height: 330px;
        object-fit: cover;
      }

      .service-copy {
        padding: 16px;
      }

      .service-copy h3 {
        font-size: clamp(1.8rem, 3vw, 3.1rem);
        margin-bottom: 16px;
      }

      .service-copy p {
        color: var(--muted);
      }

      .benefit {
        display: inline-block;
        margin-top: 12px;
        color: var(--sage-deep);
        font-weight: 870;
      }

      .about {
        display: grid;
        grid-template-columns: 0.82fr 1.18fr;
        gap: 56px;
        align-items: center;
      }

      .about__photo {
        border-radius: 42px;
        overflow: hidden;
        box-shadow: var(--shadow);
        min-height: 620px;
        background: var(--sage-soft);
      }

      .about__photo img {
        width: 100%;
        height: 100%;
        min-height: 620px;
        object-fit: cover;
      }

      .statement {
        margin-top: 28px;
        border-left: 4px solid var(--sage);
        padding: 24px 0 24px 26px;
        font-size: clamp(1.35rem, 2.4vw, 2.2rem);
        line-height: 1.15;
        letter-spacing: -0.045em;
        color: var(--sage-dark);
        font-weight: 870;
      }

      .search-simulator {
        display: grid;
        grid-template-columns: 1fr 0.9fr;
        gap: 56px;
        align-items: center;
      }

      .google-card {
        border-radius: 34px;
        background: white;
        border: 1px solid rgba(36, 51, 45, 0.08);
        box-shadow: var(--shadow);
        padding: 28px;
      }

      .search-bar {
        height: 62px;
        border: 1px solid rgba(36, 51, 45, 0.12);
        border-radius: 999px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 22px;
        color: var(--sage-dark);
        font-weight: 790;
      }

      .typed {
        min-height: 24px;
      }

      .cursor {
        display: inline-block;
        width: 2px;
        height: 20px;
        background: var(--sage-deep);
        margin-left: 4px;
        vertical-align: middle;
        animation: blink 0.9s steps(2, start) infinite;
      }

      @keyframes blink {
        50% { opacity: 0; }
      }

      .search-result {
        margin-top: 28px;
        padding: 24px;
        border-radius: 24px;
        background: var(--sage-soft);
      }

      .search-result small {
        color: var(--sage-deep);
        font-weight: 800;
      }

      .search-result strong {
        display: block;
        margin: 7px 0 8px;
        font-size: 1.15rem;
        color: #1a0dab;
      }

      .plant-divider {
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, var(--paper), #f3eee3);
        padding: 18px 0 8px;
      }

      .plant-divider__inner {
        min-height: 210px;
        border-radius: 42px;
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        align-items: center;
        gap: 28px;
        background:
          linear-gradient(90deg, rgba(255, 253, 248, 0.98), rgba(255, 253, 248, 0.72) 48%, rgba(255, 253, 248, 0.08)),
          url('https://images.unsplash.com/photo-1501004318641-b39e6451bec6?auto=format&fit=crop&q=85&w=1500') center right / cover;
        border: 1px solid rgba(56, 89, 73, 0.12);
        box-shadow: 0 18px 58px rgba(31, 52, 44, 0.08);
        padding: 26px clamp(24px, 5vw, 56px);
      }

      .plant-divider__mark {
        font-size: clamp(3.2rem, 8vw, 6rem);
        line-height: 1;
        filter: drop-shadow(0 16px 26px rgba(31,52,44,.12));
      }

      .plant-divider h2 {
        font-size: clamp(1.65rem, 3vw, 2.75rem);
        margin: 0 0 8px;
        max-width: 560px;
      }

      .plant-divider p {
        color: var(--muted);
        max-width: 540px;
        margin: 0;
      }

      .faq {
        max-width: 900px;
        margin: 0 auto;
      }

      details {
        border-bottom: 1px solid var(--line);
        padding: 18px 0;
      }

