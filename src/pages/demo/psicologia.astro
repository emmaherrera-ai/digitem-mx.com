      let searchIndex = 0;
      let charIndex = 0;
      let deleting = false;

      function typeLoop() {
        if (!typed) return;
        const current = searches[searchIndex];
        if (!deleting) {
          typed.textContent = current.slice(0, charIndex + 1);
          charIndex += 1;
          if (charIndex === current.length) {
            deleting = true;
            setTimeout(typeLoop, 1400);
            return;
          }
        } else {
          typed.textContent = current.slice(0, charIndex - 1);
          charIndex -= 1;
          if (charIndex === 0) {
            deleting = false;
            searchIndex = (searchIndex + 1) % searches.length;
          }
        }
        setTimeout(typeLoop, deleting ? 36 : 68);
