</style>
  
    <script is:inline>
      const psychologySearches = [
        'terapia para ansiedad',
        'psicóloga cerca de mí',
        'primera sesión de terapia',
        'terapia online para ansiedad',
        'psicóloga para duelo y autoestima'
      ];
      const typedSearch = document.getElementById('typed-search');
      let searchIndex = 0;
      let charIndex = 0;
      let deleting = false;
      function typeSearch(){
        if(!typedSearch) return;
        const current = psychologySearches[searchIndex];
        typedSearch.textContent = current.slice(0,charIndex);
        if(!deleting && charIndex < current.length){charIndex++;setTimeout(typeSearch,62);return;}
        if(!deleting){deleting=true;setTimeout(typeSearch,1450);return;}
        if(charIndex>0){charIndex--;setTimeout(typeSearch,32);return;}
        deleting=false;searchIndex=(searchIndex+1)%psychologySearches.length;setTimeout(typeSearch,260);
      }
      typeSearch();

      const revealGroups = [
        ['.hero-copy', 'reveal-left'],
        ['.hero-visual', 'reveal-right'],
        ['.journey-copy', 'reveal-left'],
        ['.service-journey-steps .journey-step', 'reveal-right'],
        ['.human-experience-content', 'reveal'],
        ['.human-experience-section .search-bubble', 'reveal-scale'],
        ['.search-simulator', 'reveal-left'],
        ['.search-simulator-copy', 'reveal-right'],
        ['.pricing-section .section-heading', 'reveal'],
        ['.pricing-grid .price-card', 'reveal-scale'],
        ['.presence-strip', 'reveal'],
        ['.demo-cta > *', 'reveal'],
        ['.faq-section .section-heading', 'reveal'],
        ['.faq-list details', 'reveal'],
        ['.final-cta > *', 'reveal']
      ];

      const revealItems = [];
      revealGroups.forEach(([selector, className]) => {
        document.querySelectorAll(selector).forEach((element, index) => {
          element.classList.add(className);
          element.style.setProperty('--reveal-delay', `${Math.min(index * 140, 560)}ms`);
          revealItems.push(element);
        });
      });

      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });
        revealItems.forEach((item) => revealObserver.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }

      const parallaxLayers = [...document.querySelectorAll('.journey-bg, .human-experience-bg')];
      let parallaxTicking = false;
      function updateParallax(){
        if (window.innerWidth <= 640 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          parallaxLayers.forEach((layer) => layer.style.setProperty('--parallax-y', '0px'));
          parallaxTicking = false;
          return;
        }
        parallaxLayers.forEach((layer) => {
          const section = layer.parentElement;
          const rect = section.getBoundingClientRect();
          const centerOffset = (rect.top + rect.height / 2) - window.innerHeight / 2;
          const movement = Math.max(-18, Math.min(18, centerOffset * -0.028));
          layer.style.setProperty('--parallax-y', `${movement}px`);
        });
        parallaxTicking = false;
      }
      window.addEventListener('scroll', () => {
        if (!parallaxTicking) {
          requestAnimationFrame(updateParallax);
          parallaxTicking = true;
        }
      }, { passive: true });
      updateParallax();
    </script>
