const whatsapp = 'https://wa.me/5522971545';
const auditMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX Salud. Me interesa solicitar una auditoría de 5 minutos para mi consultorio psicológico o espacio terapéutico.');
