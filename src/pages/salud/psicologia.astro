      nav{display:flex;gap:26px;font-size:.82rem;font-weight:900;color:#5b6872}.header-cta{background:var(--orange);color:white;padding:13px 18px;border-radius:999px;font-weight:900;font-size:.82rem;box-shadow:0 16px 28px rgba(224,116,34,.22)}
      .hero{min-height:calc(100vh - 78px);display:grid;grid-template-columns:minmax(0,1fr) minmax(420px,.88fr);gap:60px;align-items:center;padding:70px clamp(20px,5vw,74px);background:radial-gradient(circle at 12% 12%,rgba(216,210,255,.42),transparent 32%),radial-gradient(circle at 90% 10%,rgba(223,242,239,.85),transparent 34%),linear-gradient(180deg,#fffaf6,#f8fffe 75%,#fff)}
