const auditUrl = `${whatsapp}?text=${auditMessage}`;
const maxUrl = `${whatsapp}?text=${maxMessage}`;
const proUrl = `${whatsapp}?text=${proMessage}`;
const questionUrl = `${whatsapp}?text=${questionMessage}`;

const therapyServices = [
  'Terapia individual',
  'Ansiedad y estrés',
  'Autoestima',
  'Duelo',
  'Relaciones y pareja',
  'Terapia online',
  'Sesiones presenciales',
  'Primera sesión'
];


const maxBenefits = [
  'Landing premium para psicología con arquitectura SEO avanzada',
  'Optimización por intención de búsqueda: ansiedad, terapia online, duelo, pareja o autoestima',
  'Marcado Schema JSON-LD para servicios profesionales de salud mental',
  'Copy ético, cálido y orientado a generar confianza antes del primer mensaje',
  'Integración con Google Analytics y Search Console para medir visitas reales'
];

const proBenefits = [
  'Landing esencial de una sola página para psicología o terapia',
  'Diseño responsive rápido y cómodo para celular',
  'Estructura base para explicar servicios y enfoque profesional',
  'Botones directos a WhatsApp con mensaje estratégico y humano'
];

const faqs = [
  {
    q: '¿Por qué una psicóloga o terapeuta necesita una landing page si ya tiene Instagram?',
    a: 'Instagram ayuda a compartir contenido y crear comunidad, pero una landing page SEO funciona como un espacio profesional propio. Permite explicar tu enfoque, tus servicios y tu forma de acompañamiento de manera clara para quienes te buscan en Google.'
  },
  {
    q: '¿Se puede posicionar una página para terapia online o terapia en una zona específica?',
    a: 'Sí. En el paquete Salud Max se puede trabajar contenido orientado a intención local, terapia online y servicios específicos, siempre con un enfoque ético y sin prometer posiciones exactas en Google.'
  },
  {
    q: '¿Cómo se cuida el tono para no sonar frío, invasivo o comercial?',
    a: 'El copy se construye con lenguaje humano, cálido y profesional. Evitamos frases alarmistas, promesas de resultados y presión de compra. La intención es que la persona se sienta orientada, no perseguida.'
  },
  {
    q: '¿Qué paquete conviene más para un espacio psicológico?',
    a: 'Salud Pro funciona para una presencia clara y rápida. Salud Max conviene cuando quieres una estructura SEO más robusta, contenido por servicios, datos estructurados y una base preparada para medir visitas reales.'
  }
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Landing Pages SEO para Psicología y Terapia',
  provider: {
    '@type': 'Organization',
    name: 'DIGITEM-MX Salud',
    url: 'https://digitem-mx.com/salud'
  },
  areaServed: {
    '@type': 'Country',
    name: 'México'
  },
  serviceType: 'Diseño de landing pages SEO para psicólogas, psicólogos y terapeutas',
  description: 'Landing pages profesionales para espacios psicológicos, terapeutas y consultorios que buscan explicar sus servicios con calidez, ética y SEO local.'
};
