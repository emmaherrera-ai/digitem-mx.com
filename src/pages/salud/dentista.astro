---
const whatsapp = 'https://wa.me/5522971545';
const auditMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX Salud. Me interesa solicitar mi auditoría de 5 minutos para mi consultorio dental.');
const maxMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX Salud. Me interesa el paquete Salud Max para una landing SEO de mi consultorio dental.');
const proMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX Salud. Me interesa el paquete Salud Pro para una landing SEO de mi consultorio dental.');
const questionMessage = encodeURIComponent('Buena tarde, equipo de DIGITEM-MX Salud. Tengo una pregunta sobre las landing pages SEO para dentistas.');
const auditUrl = `${whatsapp}?text=${auditMessage}`;
const maxUrl = `${whatsapp}?text=${maxMessage}`;
const proUrl = `${whatsapp}?text=${proMessage}`;
const questionUrl = `${whatsapp}?text=${questionMessage}`;

const services = [
  'Limpieza dental',
  'Urgencias dentales',
  'Alineadores invisibles',
  'Atención familiar',
  'Valoración dental',
  'Brackets y ortodoncia',
  'Diseño de sonrisa',
  'Diagnóstico honesto'
];

const problemCards = [
  {
    number: '01',
    label: 'Especialización',
    title: 'Claridad en tus tratamientos',
    text: 'El paciente local sabrá de inmediato si realizas limpiezas, urgencias, ortodoncia, alineadores invisibles o atención familiar.'
  },
  {
    number: '02',
    label: 'Autoridad',
    title: 'Confianza médica inmediata',
    text: 'Una estructura diseñada éticamente para proyectar tu experiencia, tu enfoque clínico y las ventajas de tu consultorio antes del primer mensaje.'
  },
  {
    number: '03',
    label: 'Fricción',
    title: 'Agendamiento en un clic',
    text: 'Eliminamos los pasos complejos y los directorios saturados. WhatsApp directo reduce la fricción y acelera la intención de contacto de tus pacientes potenciales.'
  }
];

const maxBenefits = [
  'Landing dental premium con arquitectura SEO avanzada',
  'Optimización de palabras clave por servicio y zona local',
  'Marcado Schema JSON-LD de Negocio Local para Google Maps',
  'Textos persuasivos y éticos orientados a la conversión de pacientes',
  'Integración con Google Analytics y Search Console para medir tus visitas reales'
];

const proBenefits = [
  'Landing dental esencial de una sola página',
  'Diseño responsive rápido para celulares',
  'Estructura base orientada a la conversión',
  'Botones directos con mensaje estratégico a WhatsApp'
];

const faqs = [
  {
    q: '¿Por qué un consultorio dental necesita una landing page si ya tiene Instagram o Facebook?',
    a: 'Las redes sociales sirven para mostrar el día a día, pero una landing page SEO posiciona de forma permanente tus servicios médicos en los primeros resultados de Google. Permite que los pacientes que buscan activamente un dentista en tu zona te encuentren, validen tu confianza y agenden sin perderse entre publicaciones.'
  },
  {
    q: '¿Su servicio de diseño de páginas web dentales se puede enfocar en mi zona, colonia o delegación?',
    a: 'Totalmente. El núcleo del paquete Salud Max es el SEO Local. Optimizamos la estructura técnica y el contenido para las búsquedas geo-localizadas de tu consultorio, permitiendo competir directamente por los pacientes que se encuentran a solo minutos de tu ubicación real.'
  },
  {
    q: '¿Necesito tener fotografías profesionales de mi clínica dental para poder iniciar?',
    a: 'No es obligatorio para arrancar. Si cuentas con ellas, las adaptamos para mantener la velocidad de carga óptima. Si no las tienes, utilizamos un banco de imágenes médicas profesionales, luminosas y éticas que proyectan un entorno clínico moderno, limpio y confiable.'
  },
  {
    q: '¿Qué paquete conviene más para una clínica o consultorio dental?',
    a: 'Salud Pro funciona si necesitas una presencia clara y rápida. Salud Max conviene si quieres una base SEO más fuerte, optimización por servicios dentales, datos estructurados y preparación para medir visitas reales con herramientas de Google.'
  }
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Landing pages SEO para dentistas',
  provider: {
    '@type': 'Organization',
    name: 'DIGITEM-MX',
    url: 'https://digitem-mx.com'
  },
  areaServed: 'México',
  serviceType: 'Diseño y desarrollo de páginas web dentales optimizadas para SEO local',
  description: 'Landing pages SEO para dentistas, clínicas y consultorios dentales que necesitan transmitir confianza, explicar tratamientos y recibir citas por WhatsApp.',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'MXN',
    lowPrice: '2500',
    highPrice: '5000',
    offerCount: '2'
  }
};
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Landing Pages SEO para Dentistas | DIGITEM-MX Salud</title>
    <meta name="description" content="Landing pages SEO para dentistas, clínicas y consultorios dentales. Páginas web profesionales para que pacientes locales te encuentren en Google y agenden por WhatsApp." />
    <meta property="og:title" content="Landing Pages SEO para Dentistas | DIGITEM-MX Salud" />
    <meta property="og:description" content="Páginas web profesionales, rápidas y optimizadas para consultorios dentales que necesitan más confianza, SEO local y citas por WhatsApp." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://digitem-mx.com/salud/dentista" />
    <link rel="canonical" href="https://digitem-mx.com/salud/dentista" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
  </head>
  <body>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="/" aria-label="Ir a DIGITEM-MX">
          <svg class="brand-mark" viewBox="0 0 64 48" aria-hidden="true">
            <polygon class="outline outline-one" points="16,4 16,44 51,24"></polygon>
            <polygon class="outline outline-two" points="28,4 28,44 63,24"></polygon>
            <polygon class="fill" points="0,4 0,44 35,24"></polygon>
          </svg>
          <span><strong>DIGITEM-MX</strong><small>SALUD · DENTAL</small></span>
        </a>
        <nav class="nav-links" aria-label="Navegación de dentistas">
          <a href="/salud">Salud</a>
          <a href="#metodo">Método</a>
          <a href="#servicios">Tratamientos</a>
          <a href="#paquetes">Paquetes</a>
          <a href="#faq">FAQ</a>
        </nav>
        <a class="nav-cta" href={auditUrl}>Auditoría gratuita</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="kicker">PÁGINAS WEB PARA ODONTÓLOGOS</p>
          <h1>Landing Pages SEO para consultorios dentales.</h1>
          <p class="hero-text">Creamos páginas web profesionales, rápidas y optimizadas para dentistas, clínicas y consultorios dentales que necesitan aparecer en Google, transmitir confianza, explicar sus tratamientos con claridad y recibir citas constantes por WhatsApp.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={auditUrl}>Solicitar auditoría dental gratuita</a>
            <a class="btn btn-secondary" href="/demo/dentista">Ver demo dental</a>
          </div>
          <div class="trust-row" aria-label="Beneficios principales">
            <span>SEO local</span>
            <span>WhatsApp directo</span>
            <span>Schema JSON-LD</span>
          </div>
        </div>
        <aside class="hero-panel" aria-label="Resumen visual de una landing SEO dental">
          <div class="browser-card">
            <div class="browser-top"><span></span><span></span><span></span></div>
            <div class="mock-kicker">CONSULTORIO DENTAL</div>
            <div class="mock-title"></div>
            <div class="mock-line short"></div>
            <div class="mock-line"></div>
            <div class="mock-actions"><span></span><span></span></div>
            <div class="mock-services">
              {services.slice(0, 6).map((service) => <small>{service}</small>)}
            </div>
          </div>
          <div class="floating-card top-card"><strong>+ Claridad</strong><span>Tratamientos ordenados por intención de búsqueda.</span></div>
          <div class="floating-card bottom-card"><strong>1 clic</strong><span>Contacto directo a WhatsApp con mensaje estratégico.</span></div>
        </aside>
      </section>

      <section class="proof-strip" aria-label="Indicadores de valor">
        <article><strong>Google</strong><span>Estructura preparada para búsquedas locales.</span></article>
        <article><strong>WhatsApp</strong><span>Mensajes directos para pedir valoración.</span></article>
        <article><strong>SEO Dental</strong><span>Servicios, zona y confianza clínica.</span></article>
      </section>

      <section class="section diagnosis" id="metodo">
        <div class="section-eyebrow">
          <p class="kicker">DEL BUSCADOR A LA CITA</p>
          <h2>Una página dental pensada para convertir búsquedas en citas.</h2>
        </div>
        <div class="diagnosis-layout">
          <div class="photo-stack" aria-label="Consultorio dental moderno">
            <figure class="photo-card main-photo">
              <img src="https://images.unsplash.com/photo-1643660527098-559f89e45a92?auto=format&fit=crop&w=1200&q=84" alt="Consultorio dental moderno, luminoso y profesional" />
            </figure>
            <div class="insight-card">
              <span>Intención alta</span>
              <strong>El paciente no navega por curiosidad: busca resolver una necesidad dental.</strong>
            </div>
          </div>
          <div class="problem-panel">
            {problemCards.map((card) => (
              <article class="problem-row">
                <div class="problem-meta">
                  <span>{card.number}</span>
                  <small>{card.label}</small>
                </div>
                <section>
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </section>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section search-map">
        <div class="map-copy">
          <p class="kicker">MAPA DE CONVERSIÓN</p>
          <h2>La página responde justo lo que un paciente dental necesita antes de escribir.</h2>
          <p>La estructura combina SEO local, claridad de tratamientos y CTA estratégicos para convertir visitas en conversaciones reales por WhatsApp.</p>
        </div>
        <div class="map-steps">
          <article><span>01</span><h3>Busca en Google</h3><p>El usuario llega con una intención local: limpieza, urgencia, valoración, ortodoncia o estética dental.</p></article>
          <article><span>02</span><h3>Entiende tus tratamientos</h3><p>El copy ordena tus servicios para que el paciente identifique rápido si puedes ayudarle.</p></article>
          <article><span>03</span><h3>Valida tu confianza</h3><p>La interfaz proyecta un entorno profesional, ético y claro antes del primer contacto.</p></article>
          <article><span>04</span><h3>Agenda por WhatsApp</h3><p>La acción queda disponible sin directorios saturados, pasos extra o formularios fríos.</p></article>
        </div>
      </section>

      <section class="section services" id="servicios">
        <div class="service-card-photo">
          <img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1200&q=84" alt="Consultorio dental moderno, limpio y luminoso para transmitir confianza" />
          <div class="photo-caption"><strong>Tratamientos claros</strong><span>Servicios visibles para pacientes locales.</span></div>
        </div>
        <div class="service-copy">
          <p class="kicker">SERVICIOS DENTALES</p>
          <h2>Tu oferta dental, organizada por intención de búsqueda.</h2>
          <p>Ordenamos tus servicios dentales en una experiencia clara para pacientes locales. Cada bloque ayuda a explicar qué atiendes, cómo pueden contactarte y por qué tu consultorio es una opción confiable.</p>
          <ul class="service-list" aria-label="Servicios dentales sugeridos">
            {services.map((service) => <li><strong>{service}</strong></li>)}
          </ul>
          <a class="text-link" href={auditUrl}>Quiero revisar mi consultorio dental →</a>
        </div>
      </section>

      <section class="section scenarios">
        <div class="section-eyebrow split">
          <div>
            <p class="kicker">CASOS DE BÚSQUEDA</p>
            <h2>Más que una lista de tratamientos: contextos reales de decisión.</h2>
          </div>
          <p>La página puede hablarle a diferentes perfiles de paciente sin perder orden: quien tiene urgencia, quien compara ortodoncia y quien busca atención familiar.</p>
        </div>
        <div class="scenario-grid">
          <article class="scenario emergency">
            <figure class="scenario-media"><img src="https://images.unsplash.com/photo-1777331903190-341a3dd0441b?auto=format&fit=crop&w=1200&q=84" alt="Dentista conversando con paciente en consultorio moderno" /></figure>
            <div class="scenario-body"><span>Urgencia</span><h3>Necesito atención hoy</h3><p>Presenta ubicación, horarios y WhatsApp visible para que el paciente no tenga que buscar dos veces.</p></div>
          </article>
          <article class="scenario orthodontics">
            <figure class="scenario-media"><img src="https://images.unsplash.com/photo-1663755787934-3742b0f5983a?auto=format&fit=crop&w=1200&q=84" alt="Consulta dental profesional sin procedimientos invasivos" /></figure>
            <div class="scenario-body"><span>Comparación</span><h3>Quiero entender mis opciones</h3><p>Ordena ortodoncia, alineadores y valoración inicial con un lenguaje claro antes del primer mensaje.</p></div>
          </article>
          <article class="scenario family">
            <figure class="scenario-media"><img src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1200&q=84" alt="Consultorio dental luminoso y confiable" /></figure>
            <div class="scenario-body"><span>Confianza</span><h3>Busco un consultorio seguro</h3><p>Refuerza limpieza, atención familiar y diagnóstico honesto con una experiencia visual tranquila.</p></div>
          </article>
        </div>
      </section>

      <section class="section packages" id="paquetes">
        <div class="section-eyebrow split">
          <div>
            <p class="kicker">PAQUETES</p>
            <h2>Elige el nivel de presencia digital que necesita tu consultorio dental.</h2>
          </div>
          <p>Salud Max prioriza SEO local y medición. Salud Pro funciona como presencia esencial clara y rápida.</p>
        </div>
        <div class="package-layout">
          <article class="package featured">
            <p class="badge">RECOMENDADO</p>
            <h3>Salud Max</h3>
            <p class="price">$5,000 MXN</p>
            <p class="desc">Ideal para especialistas que buscan una estrategia robusta, optimizada y preparada para competir en búsquedas locales de Google.</p>
            <ul>{maxBenefits.map((benefit) => <li>{benefit}</li>)}</ul>
            <a class="btn btn-primary" href={maxUrl}>Quiero Salud Max</a>
          </article>
          <div class="value-column">
            <p class="kicker">POR QUÉ DIGITEM-MX SALUD</p>
            <h3>Diseñamos para que el paciente entienda, confíe y actúe.</h3>
            <div class="value-list">
              <div><span>01</span><strong>Entrega Express</strong><small>Presencia digital lista sin procesos eternos.</small></div>
              <div><span>02</span><strong>SEO Técnico Local</strong><small>Estructura preparada por servicio y zona.</small></div>
              <div><span>03</span><strong>Velocidad de Carga</strong><small>Experiencia rápida, especialmente en celular.</small></div>
              <div><span>04</span><strong>Garantía de Claridad</strong><small>Copy revisado para que tu oferta se entienda.</small></div>
            </div>
          </div>
          <article class="package">
            <p class="badge secondary">PRESENCIA ESENCIAL</p>
            <h3>Salud Pro</h3>
            <p class="price">$2,500 MXN</p>
            <p class="desc">Ideal para profesionales que necesitan una landing page clara, funcional y lista para recibir pacientes desde WhatsApp.</p>
            <ul>{proBenefits.map((benefit) => <li>{benefit}</li>)}</ul>
            <a class="btn btn-outline" href={proUrl}>Quiero Salud Pro</a>
          </article>
        </div>
      </section>

      <section class="section demo-showcase">
        <div class="demo-overlay">
          <p class="kicker">DEMO DENTAL</p>
          <h2>Visualiza la demo dental en una experiencia más clara.</h2>
          <p>Recorre una página ficticia diseñada para que un paciente entienda tratamientos, valide confianza clínica y encuentre el botón de WhatsApp sin fricción.</p>
          <div class="demo-actions">
            <a class="btn btn-primary" href="/demo/dentista">Ver demo dental</a>
            <a class="demo-note" href={auditUrl}>Solicitar revisión de mi consultorio →</a>
          </div>
        </div>
      </section>

      <section class="section faq" id="faq">
        <div class="section-eyebrow center">
          <p class="kicker">PREGUNTAS FRECUENTES</p>
          <h2>Resolvemos tus dudas sobre diseño de páginas web dentales y SEO local.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((item, index) => (
            <details open={index === 0}>
              <summary><span>{item.q}</span><b>+</b></summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta">
        <p class="kicker">DIAGNÓSTICO EXPRESS SIN COSTO</p>
        <h2>Descubre qué está alejando a tus pacientes potenciales en Google.</h2>
        <p>Te obsequiamos una revisión rápida de 5 minutos sobre el estado digital de tu consultorio. Sin compromisos ni discursos de venta: te mostraremos oportunidades reales para aumentar tus citas y optimizar tu presencia en internet.</p>
        <div class="hero-actions center">
          <a class="btn btn-primary" href={auditUrl}>Solicitar mi auditoría de 5 minutos</a>
          <a class="btn btn-secondary dark" href={questionUrl}>Solo quiero hacer una pregunta</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p><strong>DIGITEM-MX Salud</strong> · Landing pages SEO para profesionales de salud.</p>
      <div>
        <a href="/">DIGITEM-MX</a>
        <a href="/salud">Salud</a>
        <a href="mailto:emma_herrera@digitem-mx.com">Contacto</a>
      </div>
    </footer>

    <style>
      :root{--orange:#E07422;--teal:#11999E;--light:#F0F0F0;--dark:#333333;--ink:#0e1c26;--muted:#64737c;--line:#dcebec;--soft:#f7fbfb;--teal-soft:#e8f7f7;--orange-soft:#fff0e7;--shadow:0 28px 80px rgba(15,30,40,.12)}
